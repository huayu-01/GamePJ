[node name="Title" type="Label" parent="Root/Panel/VBox"]
theme_override_font_sizes/font_size = 30
text = "操作与流程说明"
horizontal_alignment = 1

[node name="Body" type="Label" parent="Root/Panel/VBox"]
theme_override_font_sizes/font_size = 19
text = "【移动与战斗】
  W / A / S / D    移动
  空格             跳跃
  Q                战术滑铲（滑铲期间有短暂无敌帧）
  鼠标左键         射击（按住可连续开火）
  鼠标右键         瞄准（散布更小、镜头拉近）
  装填              3 秒没开火 或 打空弹匣 会自动装填，不需要按键
  E               火力倾泻（一次性打空弹匣）
  F               互动（走近地面上的节点 / Boss 门）
  鼠标移动         转动视角        Esc 打开菜单 / 关闭弹层

【怎么变强 —— 这是本作的核心循环】
  1. 自由探索关卡，地面上散布着可交互节点（强化池 / 进化池 / 异化池 / 武器池…）
     每局随机布置，走近后按 F 使用，用掉就没了
  2. 使用节点 → 三选一奖励 → 立刻触发一场战斗（Encounter）
  3. 打赢后继续探索，去找下一个节点
  4. 想直接打 Boss：走到 Boss 门按 F，随时可以开（放弃剩余节点也行）
     前 2 次挑战免费，超出的次数会让 Boss 压力更高

【胜负与重开】
  打死 Boss = 通关；中途阵亡 = 本局结束
  结算界面点按钮或按 Enter 即可重开一局

【本界面】
  H  打开 / 关闭

【提示】
  屏幕中心的十字是准星；敌人头顶的血条与伤害数字会实时显示战斗结果。"
vertical_alignment = 1
autowrap_mode = 2
