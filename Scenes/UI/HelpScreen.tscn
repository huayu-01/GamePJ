[node name="Title" type="Label" parent="Root/Panel/VBox"]
theme_type_variation = &"UiTitle"
text = "操作与流程说明"
horizontal_alignment = 1

[node name="Body" type="Label" parent="Root/Panel/VBox"]
size_flags_vertical = 3
theme_override_font_sizes/font_size = 20
text = "【移动与战斗】
  W / A / S / D    移动
  空格             跳跃（角色 A 被动「灵动」可在空中多跳一次）
  Q                技能 1           E   技能 2
  Ctrl             下落攻击（角色 B 被动「落」）
  鼠标左键         武技 1 / 普通射击（按住可连续开火）
  鼠标右键         武技 2 / 瞄准（散布更小、镜头拉近）
  F               互动（走近地面上的节点 / Boss 门）
  鼠标移动         转动视角        Esc 打开菜单 / 关闭弹层

【怎么变强 —— 这是本作的核心循环】
  1. 自由探索关卡，地面上散布着可交互节点（强化池 / 进化池 / 异化池 / 进化池…）
     每局随机布置，走近后按 F 使用，用掉就没了
  2. 使用节点 → 三选一奖励 → 立刻触发一场战斗（Encounter）
  3. 打赢后继续探索，去找下一个节点
  4. 想直接打 Boss：走到 Boss 门按 F，随时可以开（放弃剩余节点也行）
     前 2 次挑战免费，超出的次数会让 Boss 压力更高

【胜负与重开】
  打死 Boss = 通关；中途阵亡 = 本局结束
  结算界面点按钮或按 Enter 即可重开一局

【本界面】
  H  打开 / 关闭       B  首领状况（本关 Pressure 与词条预览）
  C  角色持有（本局构筑，图标矩阵）   O  设置（画面 / 控制 / 音量）

【提示】
  屏幕中心的点就是准星；敌人头顶的血条与伤害数字会实时显示战斗结果。
  地面节点不再写名字：走近按 F，或者看颜色与图标认出是哪种池子。
  首领血条栏上会列出本关的词条：◆ = 行为型（Boss Build），◇ = 数值型（Pressure）。"
vertical_alignment = 1
autowrap_mode = 2
