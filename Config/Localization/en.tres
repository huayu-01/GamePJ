  "content.1356.name": "Power potion",
  "content.1356.description": "Add {Modifiers.0.Value:0} base attack power for {Duration}s, shared across each direct attack. Repeated pickups refresh duration instead of stacking strength.",
  "content.1357.name": "Speed potion",
  "content.1357.description": "Add {Modifiers.0.Value:0%} movement speed for {Duration}s. Repeated pickups refresh duration.",
  "content.1358.name": "Haste potion",
  "content.1358.description": "Multiply cooldowns by {Modifiers.0.Value:0.##} for {Duration}s. Repeated pickups refresh duration.",
  "content.1343.name": "Electromagnetic ring",
  "content.1343.description": "A {Effects.0.Radius}m ring starts a lightning chain hitting up to {Effects.0.Targets} targets for {Effects.0.Damage} damage each. Each target can be hit once per {Effects.0.TargetInterval}s.",
  "content.1344.name": "Weapon leech",
  "content.1344.description": "Heal for {Effects.0.Ratio:0%} of actual damage dealt by weapon skill 1 and its component attacks. Automatic secondary damage is excluded; healing restrictions apply.",
  "content.1345.name": "Cicada escape",
  "content.1345.description": "After taking {Effects.0.DamageThreshold} enemy health damage, blink to a valid point {Effects.0.MinRadius}-{Effects.0.MaxRadius}m away. Interval: {Effects.0.Cooldown}s. Failed placement preserves the damage tally.",
  "supply.heal.name": "Heal supply",
  "supply.power.name": "Power supply",
  "supply.armor.name": "Armor supply",
  "supply.speed.name": "Speed supply",
  "supply.haste.name": "Haste supply",
  "supply.experience.name": "Experience supply",
  "supply.shards.name": "Shards supply",
  "content.1346.name": "Airdrop",
  "content.1346.description": "During combat, an airdrop arrives every {Effects.0.IntervalSeconds}s at a valid point {Effects.0.MinRadius}-{Effects.0.MaxRadius}m away and lasts {Effects.0.PickupLifetime}s. Experience supplies only appear in survival.",
  "content.1347.name": "Arcane slicer",
  "content.1347.description": "Weapon skill 2 becomes an invulnerable particle dash with {Effects.0.ReplacementScene.Bounces} bounces to different enemies. Deal {Effects.0.ReplacementScene.Damage} damage per contacted target at the end, then reappear at a valid point and slide forward. Cooldown: {Effects.0.ReplacementScene.Cooldown}s.",
  "content.1348.name": "Death harvest",
  "content.1348.description": "Weapon skill 2 becomes Loathing: tap for {Effects.0.ReplacementScene.TapDamage} damage. Charge {Effects.0.ReplacementScene.ChargeBaseSeconds}-{Effects.0.ReplacementScene.ChargeMaxSeconds}s to dash and spin; each stage adds {Effects.0.ReplacementScene.DashDistancePerStep}m and {Effects.0.ReplacementScene.SpinSecondsPerStep}s. Each spin hit deals {Effects.0.ReplacementScene.SpinDamage} damage. Other active skills may interrupt it. Cooldown: {Effects.0.ReplacementScene.Cooldown}s. Dash starts at {Effects.0.ReplacementScene.BaseDashDistance}m and spin at {Effects.0.ReplacementScene.BaseSpinSeconds}s; the hit interval is {Effects.0.ReplacementScene.HitInterval}s.",
  "content.1349.name": "Slanting sun",
  "content.1349.description": "Aim and release to drive a spear along the surface normal: {Effects.0.ReplacementScene.FallDamage} descent damage and {Effects.0.ReplacementScene.ImpactDamage} impact damage in {Effects.0.ReplacementScene.Radius}m. Recast to relocate the single spear; approach to recover it. Only weapon skill 1 is locked while away. Cooldown: {Effects.0.ReplacementScene.Cooldown}s. Inherent piercing; compatible with Rainbow cooldown reduction. The embedded spear deals {Effects.0.ReplacementScene.ContactDamage} contact damage every {Effects.0.ReplacementScene.ContactInterval}s.",
  "content.1350.name": "Energy dome",
  "content.1350.description": "Weapon skill 2 opens a {Effects.0.ReplacementScene.Radius}m dome for {Effects.0.ReplacementScene.Duration}s, dealing {Effects.0.ReplacementScene.Damage} damage once and destroying destructible hostile projectiles. It grants no invulnerability. Cooldown: {Effects.0.ReplacementScene.Cooldown}s.",
  "content.1351.name": "Knife dance",
  "content.1351.description": "Weapon skill 1 throws one {Effects.0.ReplacementScene.Damage}-damage knife. Its first valid hit marks the target and releases {Effects.0.ReplacementScene.FollowupCount} homing knives for {Effects.0.ReplacementScene.FollowupDamage} damage each. Followups can be intercepted and cannot trigger Knife Dance again.",
  "content.1352.name": "Soul eye",
  "content.1352.description": "Summon a soul eye for {Effects.0.ReplacementScene.Duration}s. Every {Effects.0.ReplacementScene.MarkInterval}s it marks one visible unmarked enemy within {Effects.0.ReplacementScene.SearchRadius}m. Marks last {Effects.0.ReplacementScene.MarkDuration}s. Cooldown: {Effects.0.ReplacementScene.Cooldown}s.",
  "content.1353.name": "Magnetization",
  "content.1353.description": "Increase Electromagnetic Ring radius by 20% and its chain target count by 1.",
  "content.1354.name": "Super airdrop",
  "content.1354.description": "Reduce the airdrop interval by 30%, from 10s to 7s. Each drop still contains one supply.",
  "content.1355.name": "Shards",
  "content.1355.description": "Gain {Effects.0.Amount} run shards. They are paid once on normal settlement and discarded on adventure cancellation.",
"content.evo_wind_domain.description": "While hovering, create a ground whirlwind of radius {SpecializationBehavior.Radius}m. Contact extends hover by {SpecializationBehavior.HoverExtensionSeconds}s every {SpecializationBehavior.HoverExtensionInterval}s. It deals {SpecializationBehavior.Damage} damage every {SpecializationBehavior.TickInterval}s and slows projectiles from either side by 75%.",
"ui.survival.shard_breakdown": "Loot shards +{0} (included in this run total)",
"ui.survival.shards": "Shards {0}",
"content.mut_growth.description": "Each shot is followed by {Modifiers.ProjectileCountAdd:0} additional projectiles with a short interval.",
"content.evo_focus.description": "Weapon skill 2 throws one knife containing the base damage of all knives in that volley. Extra knives from charging also become damage.",
"content.1341.name": "Gigantism",
"content.1341.description": "Increase size by {Effects.0.SizeIncrease:0%} and maximum health by {Effects.1.Modifiers.0.Value:0}.",
"content.1342.name": "Heart of Steel",
"content.1342.description": "Every {Effects.0.KillsPerTrigger:0} enemies you defeat permanently grant {Effects.0.HealthPerTrigger:0} maximum health this run. Boss kills grant an additional {Effects.0.BossBonusHealth:0}. Current health gains the actual new capacity.",
"ui.hud.aim_assist": "Aim assist · Middle click to disable",
"content.evo_thunder_recall.description": "Recast Ruthless to teleport to the weapon and recall it, immediately triggering a landing attack at {SpecializationBehavior.LandingDamageScale:0%} power. Flight speed ×{SpecializationBehavior.SpeedScale}, range ×{SpecializationBehavior.DistanceScale}.",
