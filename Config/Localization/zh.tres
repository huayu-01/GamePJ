  "content.mut_ricochet.name": "弹射",
  "content.mut_soul_harvest.description": "每次本人击杀有 {Effects.0.Chance:0%} 概率掉出一个灵魂，玩家接触即拾取并恢复 {Effects.0.Heal:0.#} 生命",
  "content.mut_soul_harvest.name": "灵魂收割",
  "content.mut_stomp.description": "成功起跳时对周围 {Effects.0.Radius:0.#} 米内的敌人造成 {Effects.0.Damage:0.#} 点伤害，空中跳跃同样生效",
  "content.mut_stomp.name": "杀戮践踏",
  "content.mut_stomp_kill.description": "每次本人击杀立即补充 {Effects.0.ExtraAirJumps:0} 次空中跳跃，同时增加最大容量（最多 {Effects.0.JumpCap:0} 次）；满容量后仍可补回已消耗次数",
  "content.mut_stomp_kill.name": "践踏死亡",
  "content.mut_thunder_armor.description": "护甲受伤或格挡时反伤{SpecializationBehavior.ReflectDamage}并触发闪电链：最多{SpecializationBehavior.Jumps}个目标、每次{SpecializationBehavior.Damage}伤害。",
  "content.mut_thunder_armor.name": "雷凯",
  "content.mut_thunder_mark.description": "攻击没有引雷的目标时施加引雷，{SpecializationBehavior.Delay}秒后降下天雷，造成{SpecializationBehavior.Damage}伤害。",
  "content.mut_thunder_mark.name": "引雷符",
  "content.mut_wind_armor.description": "奔跑时受到的伤害降低{SpecializationBehavior.Reduction:0%}。",
  "content.mut_wind_armor.name": "风凯",
  "content.mut_wind_heart.description": "奔跑时周围产生半径{SpecializationBehavior.Radius}米的大旋风，每{SpecializationBehavior.TickInterval}秒造成{SpecializationBehavior.Damage}伤害。",
  "content.mut_wind_heart.name": "风之心",
  "content.rune_death_armor.description": "护甲 +{Effects.1.Armor:0.#}，每 {Effects.2.KillsPerTrigger:0} 次本人击杀再 +{Effects.2.ArmorPerTrigger:0.#} 护甲；无法恢复生命值。",
  "content.rune_death_armor.name": "死铠",
  "content.rune_flying_wing.description": "起跳速度 ×{Modifiers.JumpVelocityMultiplier:0.##}；正常下落速度上限 ×{Modifiers.MaxFallSpeedMultiplier:0.##}；下落攻击速度 ×{Modifiers.DiveSpeedMultiplier:0.##}。",
  "content.rune_flying_wing.name": "飞翼",
  "content.rune_giant.description": "每次攻击额外造成相当于你最大生命值 {Effects.0.Ratio:0%} 的伤害。",
  "content.rune_giant.name": "巨人",
  "content.rune_lei_seal.description": "最大生命值限制为 30；携带时「雷之印」派系的增幅（前置要求雷之印的那些）可以被抽到。",
  "content.rune_lei_seal.name": "雷之印",
  "content.rune_life_death.description": "获得 1 次死亡避免：致命伤被无效化，并恢复 30% 最大生命值。",
  "content.rune_life_death.name": "生死",
  "content.rune_march.description": "移动速度 ×{Modifiers.MoveSpeedMultiplier:0.##}。",
  "content.rune_march.name": "行军",
  "content.rune_pixie.description": "获得一只围着玩家转的小精灵，每 5 秒攻击 8 米内的一个敌人。",
  "content.rune_pixie.name": "小精灵",
  "content.rune_sniper.description": "近处（≤3 米）伤害 ×0.5，越远越高，到 ≥15 米时 ×1.5。",
  "content.rune_sniper.name": "狙神",
  "content.rune_strength_talisman.description": "造成的伤害 +20%。",
  "content.rune_strength_talisman.name": "大力符",
  "content.rune_war_seal.description": "暴击率 +10%；受到的伤害 +300%（= 承受 4 倍伤害）；携带时「战神刻印」派系的增幅可以被抽到。",
  "content.rune_war_seal.name": "战神印",
  "content.rune_wind_seal.description": "技能冷却时间 +50%；携带时「风之印」派系的增幅可以被抽到。",
  "content.rune_wind_seal.name": "风之印",
  "content.surv_anchor_afterglow.description": "锚圈半径增加{Effects.0.RadiusBonus:0.#}米；离圈后直接攻击增伤保留{Effects.0.LingerSeconds:0.#}秒，不叠加。",
  "content.surv_anchor_afterglow.name": "守望余火",
  "content.surv_anchor_core.description": "地面停留{Effects.0.StationarySeconds:0.#}秒建立{Effects.0.Radius:0.#}米锚圈，圈内直接攻击伤害+{Effects.0.DamageBonus:0%}；离圈{Effects.0.ExpirySeconds:0.#}秒消失。",
  "content.surv_anchor_core.name": "驻点核心",
  "content.surv_anchor_pulse.description": "圈内每{Effects.0.Interval:0.#}秒准备脉冲，下一次主武技命中造成{Effects.0.Radius:0.#}米、基础伤害{Effects.0.DamageScale:0%}的冲击并轻推普通敌人。",
  "content.surv_anchor_pulse.name": "净域震荡",
  "content.surv_contract_payoff.description": "本局每完成一次刻限猎令，直接攻击伤害+{Effects.0.DamagePerCompletion:0%}，最多计{Effects.0.MaxCompletions:0}次。",
  "content.surv_contract_payoff.name": "破晓清算",
  "content.surv_echo_familiar.description": "主武技命中后两枚灵偶依次协击同一目标，每枚造成基础伤害{Effects.0.DamageScale:0%}；触发间隔{Effects.0.Interval:0.#}秒，每次出手最多一轮。",
  "content.surv_echo_familiar.name": "回声灵偶",
  "content.surv_echo_lance.description": "两枚协击合为冲针，造成基础伤害{Effects.0.DamageScale:0%}，再穿过{Effects.0.ExtraPierce:0}个敌人；触发间隔改为{Effects.0.Interval:0.#}秒。",
  "content.surv_echo_lance.name": "集束协议",
  "content.surv_echo_mark.description": "协击命中留下{Effects.0.Duration:0.#}秒刻印，玩家直接攻击刻印目标伤害+{Effects.0.DamageBonus:0%}，不叠加。",
  "content.surv_echo_mark.name": "共鸣刻印",
  "content.surv_energy_echo.description": "吸收每{Effects.0.Threshold:0}点原始敌人经验充能一次；下一次主武技命中产生{Effects.0.Radius:0.#}米回响，造成该次基础伤害的{Effects.0.DamageScale:0%}。最多储备一次。",
  "content.surv_energy_echo.name": "采能回路",
  "content.surv_risk_contract.description": "敌人经验收益×{Effects.0.ExperienceScale:0.##}；实际承受的生命伤害×{Effects.0.HealthDamageScale:0.##}，不放大护甲和护盾损耗。",
  "content.surv_risk_contract.name": "危险契约",
  "content.surv_scavenger_compass.description": "经验拾取半径×{Effects.0.RadiusScale:0.##}，吸收速度×{Effects.0.SpeedScale:0.##}。",
  "content.surv_scavenger_compass.name": "拾荒罗盘",
  "content.surv_scavenger_ward.description": "每吸收{Effects.0.Threshold:0}点原始敌人经验获得最大生命{Effects.0.ShieldRatio:0%}的护盾，持续{Effects.0.Duration:0.#}秒，此来源上限{Effects.0.CapRatio:0%}；抵挡不产生格挡硬直。",
  "content.surv_scavenger_ward.name": "流转护膜",
  "content.surv_timed_hunt.description": "每{Effects.0.Interval:0}秒标记一只可达普通敌人{Effects.0.Duration:0}秒，其移速×{Effects.0.SpeedScale:0.##}；限时击败获得{Effects.0.ExperienceReward:0}额外经验。",
  "content.surv_timed_hunt.name": "刻限猎令",
  "content.upg_armor.description": "护甲 +15",
  "content.upg_armor.name": "护甲",
  "content.upg_climb.description": "跳跃高度 +8%",
  "content.upg_climb.name": "攀高",
  "content.upg_crit.description": "暴击率 +5%",
  "content.upg_crit.name": "暴击",
  "content.upg_critdmg.description": "暴击伤害 +25%",
  "content.upg_critdmg.name": "爆伤",
  "content.upg_hard.description": "受到的伤害 -5%",
  "content.upg_hard.name": "坚硬",
  "content.upg_insight.description": "角色技能冷却 -10%",
  "content.upg_insight.name": "洞悉",
  "content.upg_storm.description": "每1米/秒移动速度使伤害增加{SpecializationBehavior.DamagePerSpeed:0%}，奔跑速度也计入。",
  "content.upg_storm.name": "暴风",
  "content.upg_thunder_blast.description": "天雷对落点周围{SpecializationBehavior.Radius}米内的敌人造成范围伤害。",
  "content.upg_thunder_blast.name": "暴雷",
  "content.upg_thunder_mastery.description": "闪电链额外攻击{SpecializationBehavior.ExtraJumps}名敌人，并立刻引爆引雷；主动引爆只造成{SpecializationBehavior.DetonateScale:0%}天雷伤害。",
  "content.upg_thunder_mastery.name": "雷法",
  "content.upg_violence.description": "暴击率增加{Modifiers.CritChanceAdd:0%}；超过100%的暴击率按1:{Modifiers.CritOverflowToDamage}转为攻击力加成。",
  "content.upg_violence.name": "暴力",
  "content.upg_war_heart.description": "移速×{Modifiers.MoveSpeedMultiplier:0.##}、攻击力×{Modifiers.DamageMultiplier:0.##}、暴击率+{Modifiers.CritChanceAdd:0%}；所有坚硬及其后续等级按1:{SpecializationBehavior.ConversionRatio}转为爆伤。",
  "content.upg_war_heart.name": "战斗之心",
  "content.upg_wild_wind.description": "所有旋风尺寸变为{SpecializationBehavior.SizeScale}倍。",
  "content.upg_wild_wind.name": "狂风",
  "content.wpn_bow.description": "发射箭矢：武技1 蓄力（每 0.1s +30% 伤害与 +30 弹速，最多 1 秒）/ 武技2 刹那之眼（放大视角 + 标记目标，箭会追踪被标记的最近目标）。",
  "content.wpn_bow.name": "弓",
  "content.wpn_crossbow.description": "掷出飞刀：飞行一段距离后下坠，飞行速度较高时造成击退。武技1「飞刀散掷」同时掷出三把；武技2「千刃齐发」蓄力增加数量，所有飞刀在固定总夹角内均匀散开。",
  "content.wpn_crossbow.name": "飞刀",
  "content.wpn_energy_palm.description": "发射能量波：直线、无下坠、能穿透格挡（无视格挡效果）。伤害/弹速由武技技能行给。",
  "content.wpn_energy_palm.name": "能量波",
  "content.wpn_scythe.description": "近战武器：武技1 憎恶（3 连招，最后一刀大回旋）/ 武技2 无情（抛出武器，旋转并周期性伤害；再次使用或靠近收回）。",
  "content.wpn_scythe.name": "镰刀",
  "content.wpn_spear.name": "长枪",
  "content.wpn_spirit_sword.description": "近战武器：武技1破剑式为可斩断子弹的连续攻击；武技2三才灵剑在攻击命中后依次追击目标，全部归位后可再次追击；被动落剑式强化下落攻击。",
  "content.wpn_spirit_sword.name": "灵剑",
  "elite.aftershock.description": "攻击实际路径预警后产生一次余震。",
  "elite.aftershock.name": "余震回廊",
  "elite.arcane.description": "预警后放置固定节点旋转激光。",
  "elite.arcane.name": "秘法强化",
  "elite.armor_recoil.description": "非致死破甲后预警反冲，再短暂易伤。",
  "elite.armor_recoil.name": "裂甲反冲",
  "elite.avenger.description": "固定同波成员死亡后增强，最多三次。",
  "elite.avenger.name": "复仇",
  "elite.bruiser.description": "体型与生命提高，最终身体参与导航净空。",
  "elite.bruiser.name": "巨壮",
  "elite.burner.description": "周期铺设短暂地面火焰。",
  "elite.burner.name": "燃烧",
  "elite.burrower.description": "预警后生成短暂限制行动的藤蔓。",
  "elite.burrower.name": "蔓生",
  "elite.clanger.description": "固定同波保护对象死亡后解除无敌。",
  "elite.clanger.name": "压境",
  "elite.flanker.description": "预警后沿真实可通行路线移动至侧面。",
  "elite.flanker.name": "侧翼猎手",
  "elite.frozen.description": "冰晶延迟爆炸，短暂冻结范围内玩家。",
  "elite.frozen.name": "冰冻",
  "elite.health_link.description": "同组合法对象分担伤害，转移不再递归。",
  "elite.health_link.name": "生命链接",
  "elite.juggernaut.description": "免普通控制，移速降低，保留持盾自身硬直。",
  "elite.juggernaut.name": "强横",
  "elite.knockback.description": "本体直接攻击间歇附加击退。",
  "elite.knockback.name": "击退",
  "elite.linker.description": "与同波友军形成有预警的伤害连线。",
  "elite.linker.name": "连线",
  "elite.molten.description": "移动留火路，自然死亡后预警爆炸。",
  "elite.molten.name": "熔火",
  "elite.multishot.description": "适用射击改为三发，总伤害受限。",
  "elite.multishot.name": "多重射击",
  "elite.pressure_rebound.description": "累计有效伤害后预警释放冲击波。",
  "elite.pressure_rebound.name": "蓄压回震",
  "elite.reforge.description": "破甲后可被打断地修甲，每只最多成功一次。",
  "elite.reforge.name": "重铸",
  "elite.savior.description": "周期授予附近友军一次性挡伤护罩。",
  "elite.savior.name": "庇护",
  "elite.seeker.description": "可改造直射弹先直飞，再有限追踪。",
  "elite.seeker.name": "追踪",
  "elite.shielding.description": "无敌与开放期交替，保护来源独立。",
  "elite.shielding.name": "间歇无敌",
  "elite.shifter.description": "周期性预警换位，忙动作和空中阶段不触发。",
  "elite.shifter.name": "瞬移",
  "elite.slicer.description": "光束绕自身缓慢旋转。",
  "elite.slicer.name": "扫射",
  "elite.slugger.description": "攻击伤害提高。",
  "elite.slugger.name": "强击",
  "elite.speeder.description": "移动和恢复加快，保留攻击预警。",
  "elite.speeder.name": "迅捷",
  "elite.spiller.description": "进入暗影罩内才可伤害本体。",
  "elite.spiller.name": "黑雾",
  "elite.spinner.description": "三颗伤害球环绕本体。",
  "elite.spinner.name": "环星",
  "elite.summoner.description": "免费召唤有限一批普通随从，不补员。",
  "elite.summoner.name": "召唤",
  "elite.suppressor.description": "周期阻挡来自罩外的指定远程投射物。",
  "elite.suppressor.name": "压制",
  "elite.thorn_grid.description": "地板接触触发荆棘效果，跳跃可以躲避。",
  "elite.thorn_grid.name": "荆棘棋盘",
  "elite.tidal.description": "内圈与外环交替爆发，保留安全带。",
  "elite.tidal.name": "潮汐领域",
  "elite.trail_brand.description": "短暂标记玩家经过处，延迟产生有限爆点。",
  "elite.trail_brand.name": "疾行烙印",
  "elite.vampiric.description": "本体直接攻击按实际生命伤害吸血。",
  "elite.vampiric.name": "吸血",
