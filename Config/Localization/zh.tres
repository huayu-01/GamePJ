  "content.mut_blood_battle.name": "血战",
  "content.mut_burn.description": "命中使目标燃烧 {Effects.0.Duration:0.##} 秒",
  "content.mut_burn.name": "灼烧弹",
  "content.mut_cleave.description": "近战攻击范围 +30%、伤害 +20%；投掷长枪和镰刀的模型与伤害范围同步扩大。",
  "content.mut_cleave.name": "大刀阔斧",
  "content.mut_death_duel.description": "致命伤后保持当前状态；{SpecializationBehavior.Duration}秒内击杀{SpecializationBehavior.RequiredKills}名敌人可避免死亡并恢复{SpecializationBehavior.HealFraction:0%}生命，冷却{SpecializationBehavior.Cooldown}秒。",
  "content.mut_death_duel.name": "死斗",
  "content.mut_energy_shield.description": "格挡成功或护甲被打光时，对周围敌人造成伤害",
