script = ExtResource("1")
Locale = "zh"
RequireComplete = true
Messages = {
"ui.supply.survival_only": "死战限定",
  "ui.run.bonus_shards": "补给与资源强化碎片 +{0}（已包含在本局总收益中）",
  "skill.1352.name": "灵魂之眼",
  "skill.1351.name": "刀舞",
  "skill.1350.name": "能量罩",
  "skill.1349.name": "斜阳穿隙",
  "skill.1348.name": "厌恶",
  "skill.1347.name": "秘法切刃",
  "content.1356.name": "力量药剂",
  "content.1356.description": "基础攻击+{Modifiers.0.Value:0}，持续{Duration}秒，按一次直接出手在多弹/组成段间分配；再次拾取刷新时间，不叠加强度。",
  "content.1357.name": "速度药剂",
  "content.1357.description": "移速+{Modifiers.0.Value:0%}，持续{Duration}秒；再次拾取刷新时间，不叠加强度。",
  "content.1358.name": "急速药剂",
  "content.1358.description": "冷却倍率×{Modifiers.0.Value:0.##}，持续{Duration}秒；再次拾取刷新时间，不叠加强度。",
  "content.1343.name": "电磁圈",
  "content.1343.description": "周围{Effects.0.Radius}米形成电磁圈，接触敌人引发最多{Effects.0.Targets}个目标的闪电链，每跳{Effects.0.Damage}伤害；同一目标每{Effects.0.TargetInterval}秒至多受电圈伤害一次。",
  "content.1344.name": "汲血",
  "content.1344.description": "武技1及其组成追击段实际造成伤害的{Effects.0.Ratio:0%}转为生命恢复；不含自动衍生伤害，并遵循禁疗。",
  "content.1345.name": "金蝉脱壳",
  "content.1345.description": "累计受到敌方{Effects.0.DamageThreshold}点生命伤害后，在{Effects.0.MinRadius}～{Effects.0.MaxRadius}米内随机瞬移到有效位置；触发间隔{Effects.0.Cooldown}秒，成功后清空累计。",
  "supply.heal.name": "生命药剂",
  "supply.power.name": "力量药剂",
  "supply.armor.name": "护甲片",
  "supply.speed.name": "速度药剂",
  "supply.haste.name": "急速药剂",
  "supply.experience.name": "经验药剂",
  "supply.shards.name": "碎片包",
  "content.1346.name": "天降空投",
  "content.1346.description": "战斗中每{Effects.0.IntervalSeconds}秒在周围{Effects.0.MinRadius}～{Effects.0.MaxRadius}米有效位置落下一份补给，留场{Effects.0.PickupLifetime}秒。补给包含生命、力量、护甲、速度、急速、碎片；死战还可出现经验。",
  "content.1347.name": "秘法切刃",
  "content.1347.description": "武技2化为无敌粒子优先飞向锁定目标，再向附近敌人弹射{Effects.0.ReplacementScene.Bounces}次，不重复命中；结束时每目标造成{Effects.0.ReplacementScene.Damage}基础伤害，在最后目标附近有效位置现身并前滑。冷却{Effects.0.ReplacementScene.Cooldown}秒。",
  "content.1348.name": "死亡收割",
  "content.1348.description": "武技2替换为厌恶：点按旋转造成{Effects.0.ReplacementScene.TapDamage}伤害；蓄力{Effects.0.ReplacementScene.ChargeBaseSeconds}～{Effects.0.ReplacementScene.ChargeMaxSeconds}秒，基础冲刺{Effects.0.ReplacementScene.BaseDashDistance}米、旋转{Effects.0.ReplacementScene.BaseSpinSeconds}秒；每档再增加{Effects.0.ReplacementScene.DashDistancePerStep}米与{Effects.0.ReplacementScene.SpinSecondsPerStep}秒。每{Effects.0.ReplacementScene.HitInterval}秒造成{Effects.0.ReplacementScene.SpinDamage}伤害。可被其它主动技能打断，冷却{Effects.0.ReplacementScene.Cooldown}秒。",
  "content.1349.name": "斜阳穿隙",
  "content.1349.description": "武技2按住瞄准、松开沿表面法线刺落；下落{Effects.0.ReplacementScene.FallDamage}伤害，落点半径{Effects.0.ReplacementScene.Radius}米造成{Effects.0.ReplacementScene.ImpactDamage}伤害；枪身每{Effects.0.ReplacementScene.ContactInterval}秒接触造成{Effects.0.ReplacementScene.ContactDamage}伤害。靠近收回，离手仅锁武技1，武技2可重定位。冷却{Effects.0.ReplacementScene.Cooldown}秒，本体自带穿透，兼容气贯长虹减冷却。",
  "content.1350.name": "能量罩",
  "content.1350.description": "武技2撑开半径{Effects.0.ReplacementScene.Radius}米的能量罩，造成一次{Effects.0.ReplacementScene.Damage}伤害，持续{Effects.0.ReplacementScene.Duration}秒，摧毁罩内可摧毁的敌方投掷物；不提供无敌，罩体90%透明。冷却{Effects.0.ReplacementScene.Cooldown}秒。",
  "content.1351.name": "刀舞",
  "content.1351.description": "武技1改成一把{Effects.0.ReplacementScene.Damage}伤害飞刀，首次有效命中施加标记，再从背后依次发射{Effects.0.ReplacementScene.FollowupCount}枚{Effects.0.ReplacementScene.FollowupDamage}伤害追击刀，随机展开后拐向目标，可被其它目标或地形拦截，追击不递归。",
  "content.1352.name": "灵魂之眼",
  "content.1352.description": "武技2召唤头顶灵魂眼，持续{Effects.0.ReplacementScene.Duration}秒，每{Effects.0.ReplacementScene.MarkInterval}秒给{Effects.0.ReplacementScene.SearchRadius}米内一个未标记的可见敌人加标记；标记持续{Effects.0.ReplacementScene.MarkDuration}秒，不重复叠加。冷却{Effects.0.ReplacementScene.Cooldown}秒，保留手动攻击。",
  "content.1353.name": "磁化",
  "content.1353.description": "电磁圈半径增加20%，闪电链总目标数增加1。",
  "content.1354.name": "超级空投",
  "content.1354.description": "天降空投的间隔缩短30%，由10秒变为7秒；每次仍一份。",
  "content.1355.name": "碎片",
  "content.1355.description": "获得{Effects.0.Amount}本局碎片；正常结束时兑现，取消冒险作废。",
"ui.survival.shard_breakdown": "战利品碎片 +{0}（已包含在本局总收益中）",
"ui.survival.shards": "碎片 {0}",
"content.1341.name": "巨化",
"content.1341.description": "体型增加{Effects.0.SizeIncrease:0%}，最大生命值增加{Effects.1.Modifiers.0.Value:0}。",
"content.1342.name": "心之钢",
"content.1342.description": "每累计{Effects.0.KillsPerTrigger:0}次本人敌方击杀，永久增加本局{Effects.0.HealthPerTrigger:0}点最大生命；击杀首领额外增加{Effects.0.BossBonusHealth:0}点。当前生命同步补足实际新增上限。",
"ui.hud.aim_assist": "辅助瞄准 · 中键关闭",
"ui.codex.unit_stats": "基础生命 {0:0}  ·  初始护甲 {1:0}\n基础移速 {2:0.0}\n\n实战数值会随关卡和精英效果变化。",
"ui.codex.skill_stats": "基础冷却 {0:0.##} 秒\n\n实战冷却受构筑影响。",
"ui.codex.rune_rule": "出击前在基地携带一枚，效果随本次冒险生效。",
"ui.codex.scene_rune_rule": "每个场景仅有一种场景符文。当前效果显示在死战HUD中。",
"ui.codex.special_behavior": "留意其特殊行动和攻击预警。",
"ui.codex.boss_rule": "首领的攻击不会被普通受击打断。观察预警，利用技能间隙输出。",
"ui.codex.elite_rule": "每波最多一种精英特性。强效特性可能只出现在一名精英身上。",
"ui.codex.node_rule": "靠近目标，按F交互，查看具体收益与挑战要求。",
"ui.codex.adventure_rule": "冒险关卡：探索节点、完成战斗、获取构筑，再挑战首领。",
"ui.codex.survival_rule": "死战：保留手动战斗，拾取经验升级，限时后挑战首领。",
"ui.codex.survival_objects": "蓝绿色信标：靠近按F启动，留在圆环内完成净化，回复15%生命并选增幅；三座全部净化可削弱首领。\n\n橙色遗物：阶段强敌掉落，靠近按F选择死战专属增幅。\n\n金色撤离门：击败终局首领后开启，按F完成本次冒险。",
