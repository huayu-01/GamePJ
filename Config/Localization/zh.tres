"ui.codex.behavior.BasicMelee": "追近后发动近战。",
"ui.codex.behavior.FastMelee": "快速追近后发动近战。",
"ui.codex.behavior.SelfDestruct": "接近后蓄势自爆；预警期间可打断或离开爆炸范围。",
"ui.codex.behavior.FrontalGuard": "能格挡来自正面的攻击，绕到侧后方寻找机会。",
"ui.codex.behavior.TimedGuard": "先持盾防御，再根据距离选择攻击。",
"ui.codex.behavior.StraightCharge": "朝锁定方向直线冲锋，注意路径预警。",
"ui.codex.behavior.HomingCharge": "冲锋时追踪目标，接近后衔接攻击。",
"ui.codex.behavior.FollowupMelee": "接近目标或碰撞后衔接近战。",
"ui.codex.behavior.BurrowRelocate": "攻击后遁地，重新出现在玩家附近。",
"ui.codex.behavior.HomingShot": "发射有限航程的追踪弹。",
"ui.codex.behavior.DirectShot": "保持距离，朝玩家发射直射弹。",
"ui.codex.behavior.ArcThrow": "保持距离，投掷沿抛物线飞行的弹体。",
"ui.codex.behavior.BombPayload": "投掷物接触目标或达到航程后爆炸。",
"ui.codex.behavior.ForwardBomb": "向前丢出炸弹，接触目标或达到航程后爆炸。",
"ui.codex.behavior.CloseMelee": "被近身时可以使用近战攻击。",
"ui.codex.behavior.BackHop": "被近身时会后跳拉开距离。",
"ui.codex.behavior.DashSpin": "短暂蓄势后突进并回旋斩击。",
"ui.codex.behavior.DashCombo": "连续发动多段近战，每段附带突进。",
"ui.codex.behavior.GroundSlam": "靠近后蓄势重击砸地，造成范围伤害。",
"ui.codex.behavior.HoverDive": "跃起并短暂滞空，再向目标方向俯冲。",
"ui.codex.behavior.LeapMelee": "跳向目标并发动落地攻击，留意落点预警。",
"ui.codex.behavior.MeteorCast": "进入距离后蓄力，在玩家位置召唤陨落攻击。",
"ui.codex.behavior.AreaSlow": "在周围制造减速效果。",
"ui.codex.behavior.SupportAura": "为附近的同伴提供支援效果。",
"content.evo_light_leap.description": "地面跳跃瞬移上升至基础跳高的{Effects.0.HeightMultiplier:0}倍，并获得{Effects.0.HoverSeconds:0.0}秒自动浮空；落的冷却减少{Effects.1.Tuning.CooldownReduction:0%}。按下落攻击键（默认Ctrl，可改键）取消浮空。",
"content.wpn_spear.description": "中距离武器：武技1 横扫千军（四段循环）；武技2 长虹贯日（无蓄力直线投枪）。被动落日余晖：空中显示落点与可选范围，水平半径为离地高度的{FallAttackAim.AimRadiusHeightRatio:0}倍，下落速度增加{FallAttackAim.DiveSpeedBonus:0%}。",
"ui.survival.beacon_prompt": "净化信标 {0} · 启动后在圈内停留{1:0.#}秒；恢复15%生命并选增幅；净化全部3座可削弱首领",
"ui.survival.relic_prompt": "强敌遗物 · 选择1项增幅（需要交互，不会自动拾取）",
"ui.survival.beacon_channel": "信标净化中 · 保持在圈内；离圈会倒退进度",
"ui.survival.beacon_progress": "净化 {0:0}%{1}",
"ui.survival.beacon_return": " · 返回圈内",
"ui.survival.objective_help": "蓝绿色圆锥＋圆环：靠近按F净化信标，启动后留在圈内。\n橙色遗物：靠近按F选择增幅。",
"ui.survival.relic_drop": "强敌已击败 · 靠近橙色遗物，按F选择增幅",
"content.skl_a1_skill_2.name": "跃升",
"content.skl_a1_skill_2.description": "按 E：强力跳跃（起跳速度 {LeapVelocity:0.#} m/s）并获得 {HoverSeconds:0.#}s 滞空 —— 空中默认自动下落减缓 {HoverFallSlowPercent:0.##}×100%（脚底出现光环），按Ctrl（下落攻击键，可改键）取消浮空，还有跳跃次数时会先执行跳跃。CD {Cooldown:0}s。",
"content.upg_life_plus.name": "升级：生命",
"content.mut_lunge_plus2.description": "替换上一级效果：突进距离增加+{Modifiers.MeleeLungeAdd:0.##}，可穿过敌人",
"content.mut_growth_plus.description": "每次发射后额外连续跟发{Modifiers.ProjectileCountAdd:0}发子弹，保留短暂间隔。",
"content.evo_rainbow.description": "长虹贯日可以贯穿所有敌人，冷却时间减少{Effects.0.Tuning.CooldownReduction:0%}。",
"content.mut_freeze_plus.name": "升级：冰晶",
"content.mut_cleave_plus.description": "替换上一级效果：近战范围倍率×{Modifiers.AttackRangeMultiplier:0.##}，伤害倍率×{Modifiers.DamageMultiplier:0.##}",
"content.mut_lunge_plus.name": "升级：剑突",
"content.upg_power.name": "力量",
"content.upg_hard_plus2.name": "升级：坚硬（2级）",
"content.mut_haste_plus.name": "升级：速攻",
"content.mut_pierce_plus.name": "升级：穿透",
"content.upg_critdmg_plus.name": "升级：爆伤",
"content.mut_lunge_plus2.name": "升级：剑突（2级）",
"content.mut_growth_plus.name": "升级：增生",
"content.mut_haste_plus.description": "替换上一级效果：冷却倍率×{Modifiers.CooldownMultiplier:0.##}",
"content.upg_hard_plus2.description": "替换上一级效果：伤害减免增加+{Modifiers.DamageReductionAdd:0.#%}",
"content.upg_critdmg_plus2.description": "替换上一级效果：暴击伤害增加+{Modifiers.CritMultiplierAdd:0.#%}",
"content.skl_b3_w1_2.name": "长虹贯日",
"content.upg_crit_plus2.description": "替换上一级效果：暴击率增加+{Modifiers.CritChanceAdd:0.#%}",
"content.mut_pierce_plus2.description": "替换上一级效果：额外穿透数+{Modifiers.PierceAdd:0.##}",
"content.upg_life.name": "生命",
"content.mut_burn_plus.description": "替换上一级效果：燃烧变得更强",
"content.upg_swift.description": "每级增加8个百分点移速加成，按固定值相加。",
"content.mut_ricochet_plus.description": "替换上一级效果：额外弹射次数+{Modifiers.RicochetAdd:0.##}",
"content.upg_critdmg_plus.description": "替换上一级效果：暴击伤害增加+{Modifiers.CritMultiplierAdd:0.#%}",
"content.upg_life_plus2.description": "替换上一级效果：最大生命增加+{Modifiers.MaxHealthAdd:0.##}",
"content.1337.description": "护甲破碎后获得一次格挡护罩，保留{Effects.0.Duration:0}秒，消耗或到期后消失；无格挡硬直。",
"content.upg_swift.name": "快速",
"content.mut_haste_plus2.description": "替换上一级效果：冷却倍率×{Modifiers.CooldownMultiplier:0.##}",
"content.upg_hard_plus.description": "替换上一级效果：伤害减免增加+{Modifiers.DamageReductionAdd:0.#%}",
"content.upg_critdmg_plus2.name": "升级：爆伤（2级）",
"content.mut_ricochet_plus2.name": "升级：弹射（2级）",
"content.upg_life_plus.description": "替换上一级效果：最大生命增加+{Modifiers.MaxHealthAdd:0.##}",
"content.1338.description": "每次成功格挡对周围{Effects.0.Radius:0.#}米敌人造成{Effects.0.Damage:0}点伤害并击退，范围受大刀阔斧影响。",
"ui.reward_upgrade_level": "升级：{Name} [{Level}级]",
"content.upg_crit_plus.name": "升级：暴击",
"content.evo_rainbow.name": "气贯长虹",
"content.upg_crit_plus2.name": "升级：暴击（2级）",
"content.mut_ricochet_plus.name": "升级：弹射",
"content.upg_power.description": "每级增加15个百分点伤害加成，按固定值相加。",
"content.skl_b3_w1_2.description": "向准星方向快速发射直线长枪，伤害{LanceDamage:0}并击退，最多命中{LanceMaxTargets:0}名敌人；不蓄力，冷却{Cooldown:0}秒。",
"content.upg_life_plus2.name": "升级：生命（2级）",
"content.upg_life.description": "每级最大生命+20，按固定值相加。",
"content.mut_growth_plus2.name": "升级：增生（2级）",
"content.skl_b_skill_2.description": "进入持续{StanceSeconds:0.##}秒的招架窗口，可连续格挡并反弹敌方远程弹体；格挡者有自身硬直，窗口不因成功格挡提前结束。",
"content.mut_haste_plus2.name": "升级：速攻（2级）",
"content.mut_lunge_plus.description": "替换上一级效果：突进距离增加+{Modifiers.MeleeLungeAdd:0.##}",
"content.mut_growth_plus2.description": "每次发射后额外连续跟发{Modifiers.ProjectileCountAdd:0}发子弹，保留短暂间隔。",
