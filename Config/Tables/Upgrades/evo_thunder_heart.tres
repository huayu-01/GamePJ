[gd_resource type="Resource" script_class="RewardConfig" load_steps=6 format=3]

[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="row"]
[ext_resource type="Script" path="res://Scripts/Config/ParamEntry.cs" id="param"]

[sub_resource type="Resource" id="p_Damage"]
script = ExtResource("param")
Key = "Damage"
Value = 14
Note = "机制参数；原文未给的数值为可调预设，文案共读此值。"

[sub_resource type="Resource" id="p_Jumps"]
script = ExtResource("param")
Key = "Jumps"
Value = 3
Note = "机制参数；原文未给的数值为可调预设，文案共读此值。"

[sub_resource type="Resource" id="p_Range"]
script = ExtResource("param")
Key = "Range"
Value = 7
Note = "机制参数；原文未给的数值为可调预设，文案共读此值。"

[resource]
script = ExtResource("row")
Id = "evo_thunder_heart"
DisplayName = "雷之心"
RewardKind = 1
MaxStacks = 1
ApplyHandler = "Specialization"
Specialization = 8
HandlerParams = [SubResource("p_Damage"), SubResource("p_Jumps"), SubResource("p_Range")]
DescriptionTemplate = "攻击触发闪电链，对最多{Jumps}个目标各造成{Damage}伤害，跳跃范围{Range}米。"
Requires = PackedStringArray("雷之印")
Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"
