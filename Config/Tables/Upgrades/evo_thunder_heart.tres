MaxStacks = 1
Effects = [SubResource("specialization_effect")]
Specialization = 8
DescriptionTemplate = "攻击触发闪电链，对最多{SpecializationBehavior.Jumps}个目标各造成{SpecializationBehavior.Damage}伤害，跳跃范围{SpecializationBehavior.Range}米；冷却{SpecializationBehavior.CooldownSeconds:0.#}秒。"
Requires = PackedStringArray("rune_lei_seal")
Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"

