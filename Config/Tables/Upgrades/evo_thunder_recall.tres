[gd_resource type="Resource" script_class="RewardConfig" format=3]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="row"]
[ext_resource type="Resource" path="res://Config/Tables/UpgradePools/pool_scythe.tres" id="pool"]
[ext_resource type="Resource" path="res://Config/Tables/Skills/skl_b2_w1_2.tres" id="skill"]
[ext_resource type="Resource" path="res://Config/Tables/Skills/skl_b_fall.tres" id="fall"]

[ext_resource type="Script" path="res://Scripts/Config/Specializations/ThunderRecallBehaviorDefinition.cs" id="behavior_definition"]

[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/SpecializationRewardEffect.cs" id="specialization_effect"]

[sub_resource type="Resource" id="behavior_definition"]
script = ExtResource("behavior_definition")
LandingDamageScale = 1
SpeedScale = 2
DistanceScale = 1.5
Targets = [ExtResource("skill"), ExtResource("fall")]


[sub_resource type="Resource" id="specialization_effect"]
script = ExtResource("specialization_effect")
Definition = SubResource("behavior_definition")

[resource]
script = ExtResource("row")
Excludes = PackedStringArray("1348")
NumericId = 1240
Id = "evo_thunder_recall"
DisplayName = "落雷术"
RewardKind = 1
MaxStacks = 1
Effects = [SubResource("specialization_effect")]
Specialization = 10
DescriptionTemplate = "无情再次使用改为瞬移到武器中心并接触收回，立即触发{SpecializationBehavior.LandingDamageScale:0%}倍率的下落落地攻击；飞行速度×{SpecializationBehavior.SpeedScale}，飞行距离×{SpecializationBehavior.DistanceScale}。"
Requires = PackedStringArray("rune_lei_seal")
Pool = ExtResource("pool")
RequiredCharacterIds = PackedStringArray("chr_weapon_master")

Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"

NameKey = "content.evo_thunder_recall.name"

DescriptionKey = "content.evo_thunder_recall.description"
