[gd_resource type="Resource" script_class="RewardConfig" format=3]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="row"]
[ext_resource type="Resource" path="res://Config/Tables/Skills/skl_a1_skill_2.tres" id="skill_a"]
[ext_resource type="Resource" path="res://Config/Tables/Skills/skl_b_skill_2.tres" id="skill_b"]

[ext_resource type="Script" path="res://Scripts/Config/Specializations/ThunderPoolBehaviorDefinition.cs" id="behavior_definition"]

[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/SpecializationRewardEffect.cs" id="specialization_effect"]

[sub_resource type="Resource" id="behavior_definition"]
script = ExtResource("behavior_definition")
Damage = 25
Duration = 6
Radius = 4
TickInterval = 1
Targets = [ExtResource("skill_a"), ExtResource("skill_b")]


[sub_resource type="Resource" id="specialization_effect"]
script = ExtResource("specialization_effect")
Definition = SubResource("behavior_definition")

[resource]
script = ExtResource("row")
NumericId = 1239
Id = "evo_thunder_pool"
DisplayName = "雷池"
RewardKind = 1
MaxStacks = 1
Effects = [SubResource("specialization_effect")]
Specialization = 9
DescriptionTemplate = "释放角色技能2时在脚下留下雷池，半径{SpecializationBehavior.Radius}米、持续{SpecializationBehavior.Duration}秒，每{SpecializationBehavior.TickInterval}秒降下{SpecializationBehavior.Damage}伤害的天雷。"
Requires = PackedStringArray("rune_lei_seal")

Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"

NameKey = "content.evo_thunder_pool.name"

DescriptionKey = "content.evo_thunder_pool.description"
