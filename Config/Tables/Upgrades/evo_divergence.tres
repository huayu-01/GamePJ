[gd_resource type="Resource" script_class="RewardConfig" format=3]

[ext_resource type="Script" path="res://Scripts/Config/ParamEntry.cs" id="1_param"]
[ext_resource type="Resource" path="res://Config/Tables/UpgradePools/pool_energy_palm.tres" id="1_pool"]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="2_row"]

[sub_resource type="Resource" id="Resource_p0"]
script = ExtResource("1_param")
Key = "StatusId"
Value = "Mark"
Note = "挂哪一条状态（效果表的 Mark 行，可叠加 5 层）"

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("1_param")
Key = "Duration"
Value = 6.0
Note = "标记时长"

[resource]
script = ExtResource("2_row")
RewardKind = 1
MaxStacks = 1
ApplyHandler = "BurnOnHit"
HandlerParams = [SubResource("Resource_p0"), SubResource("Resource_p1")]
RequiredCharacterIds = PackedStringArray("chr_hunter")
Pool = ExtResource("1_pool")
Id = "evo_divergence"
DisplayName = "发散"
DescriptionTemplate = "武技1 命中时会对目标施加一层标记"
Note = "[P5b 新增行] 文档第 58 行（进化池 <A1限定>）「发散:武技1命中时会对目标施加一层标记,每层标记额外提升技能1的伤害{N}%」。**只接了前半**（命中挂标记，复用既有的 BurnOnHit 处理器 + 效果表的 Mark 行：可叠加、不限定单个目标）。⚠️ 后半「每层标记额外提升技能 1 的伤害 N%」需要一条新的伤害通路（按**目标身上的标记层数**加伤），P5b **未接** —— 见 docs/upgrades.md §7。⚠️ 标记时长文档没写 → 预设 6s（沿用 eff_mark 的 Duration）。"
