Effects = [SubResource("definition")]
Id = "mut_stomp_kill"
DisplayName = "践踏死亡"
DescriptionTemplate = "每次本人击杀立即补充 {Effects.0.ExtraAirJumps:0} 次空中跳跃，同时增加最大容量（最多 {Effects.0.JumpCap:0} 次）；满容量后仍可补回已消耗次数"
Note = "J25：按每次击杀逐个计入，移除旧0.1秒冷却；纯计数不经过攻击连锁次数／深度门。用户确认空中击杀立即可用，满容量后也可补回已消耗次数，不等落地；每杀1／封顶3沿用可调预设，保留灵动及其他来源已有次数。效果与说明同读Effects。"

NameKey = "content.mut_stomp_kill.name"

