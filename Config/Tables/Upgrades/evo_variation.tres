[ext_resource type="Resource" path="res://Config/Tables/Skills/skl_a3_w1_1.tres" id="4_ability"]

[sub_resource type="Resource" id="Resource_ramp"]
script = ExtResource("3_ramp")
TargetAbility = ExtResource("4_ability")
MaxCount = 3
WindowSeconds = 1.2
ShotIntervalSeconds = 0.08

[resource]
script = ExtResource("2_row")
RewardKind = 1
MaxStacks = 1
ApplyHandler = "VolleyRamp"
VolleyRamp = SubResource("Resource_ramp")
RequiredCharacterIds = PackedStringArray("chr_hunter")
Pool = ExtResource("1_pool")
Id = "evo_variation"
DisplayName = "变奏"
DescriptionTemplate = "武技1点按快射按1→2→3箭循环，逐箭间隔0.08秒；长按仍可蓄力。连续射击窗口1.2秒。"
Note = "J6按用户确认：点按不用先蓄满0.5秒，1→2→3循环；二／三连发按表内短间隔逐箭射出。首箭必须到释放动画真实ATK，未发出的后续箭可被打断取消。强类型VolleyRamp资源引用目标技能；窗口1.2s、间隔0.08s是可配预设。"
