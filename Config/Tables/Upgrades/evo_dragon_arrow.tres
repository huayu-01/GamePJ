[gd_resource type="Resource" script_class="RewardConfig" format=3]

[ext_resource type="Script" path="res://Scripts/Config/ParamEntry.cs" id="1_param"]
[ext_resource type="Resource" path="res://Config/Tables/UpgradePools/pool_bow.tres" id="1_pool"]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="2_row"]

[sub_resource type="Resource" id="Resource_p0"]
script = ExtResource("1_param")
Key = "AbilityId"
Value = "skl_a3_w1_1"
Note = "改哪一条技能行（弓武技1 箭在弦上）"

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("1_param")
Key = "ChargeMaxSeconds"
Value = 3.0
Note = "蓄力上限 1s → 3s"

[resource]
script = ExtResource("2_row")
RewardKind = 1
MaxStacks = 1
ApplyHandler = "AbilityOverride"
HandlerParams = [SubResource("Resource_p0"), SubResource("Resource_p1")]
RequiredCharacterIds = PackedStringArray("chr_hunter")
Pool = ExtResource("1_pool")
Id = "evo_dragon_arrow"
DisplayName = "龙之箭"
DescriptionTemplate = "武技1 现在可以蓄力 3 秒"
Note = "[P5b 新增行] 文档第 94 行（进化池 <A3限定>）「龙之箭:武技1现在可以蓄力3秒,且蓄力2秒后射出的箭会更大且附带全穿透效果」。**只接了前半**（ChargeMaxSeconds 1s → 3s，这一列 P2 就有，弓的档位上限直接读它）。⚠️ 后半「蓄力 2 秒后箭更大 + 全穿透」需要"按累计蓄力时长切换弹型"的新通路，P5b **未接** —— 见 docs/upgrades.md §7。"
