[gd_resource type="Resource" script_class="RewardConfig" format=3]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="row"]
[ext_resource type="Script" path="res://Scripts/Config/Specializations/ThunderMarkBehaviorDefinition.cs" id="behavior_definition"]

[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/SpecializationRewardEffect.cs" id="specialization_effect"]

[sub_resource type="Resource" id="behavior_definition"]
script = ExtResource("behavior_definition")
Damage = 40
Delay = 4


[sub_resource type="Resource" id="specialization_effect"]
script = ExtResource("specialization_effect")
Definition = SubResource("behavior_definition")

[resource]
script = ExtResource("row")
NumericId = 1280
Id = "mut_thunder_mark"
DisplayName = "引雷符"
RewardKind = 2
MaxStacks = 1
Effects = [SubResource("specialization_effect")]
Specialization = 1
DescriptionTemplate = "攻击没有引雷的目标时施加引雷，{SpecializationBehavior.Delay}秒后降下天雷，造成{SpecializationBehavior.Damage}伤害。"
Requires = PackedStringArray("rune_lei_seal")
Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"

NameKey = "content.mut_thunder_mark.name"

DescriptionKey = "content.mut_thunder_mark.description"
