[resource]
script = ExtResource("row")
Id = "evo_war_spear"
DisplayName = "战斗之矛"
RewardKind = 1
MaxStacks = 1
ApplyHandler = "Specialization"
Specialization = 12
HandlerParams = [SubResource("p_Damage"), SubResource("p_Lifetime"), SubResource("p_Range"), SubResource("p_Speed"), SubResource("p_TurnRate")]
DescriptionTemplate = "暴击时从身上向附近敌人发射一枚追踪箭，造成{Damage}伤害。"
Requires = PackedStringArray("战神刻印")
SpecializationProjectile = ExtResource("projectile")
Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"
