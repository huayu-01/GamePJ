Id = "evo_affection"
DisplayName = "喜爱"
DescriptionTemplate = "武器飞出后每2秒飞向离玩家最近的敌人"
ApplyHandler = "WeaponSeek"
WeaponSeek = SubResource("Seeking")
Note = "J15：真实离手后每2游戏秒选择离玩家最近的有效敌对单位，悬停可重新飞行，到目标点或每段原射程后停留；周期伤害、手动与靠近召回保持。目标高度0.9m为可配预设，间隔2秒来自原文。"
