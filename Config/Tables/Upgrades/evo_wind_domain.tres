[gd_resource type="Resource" script_class="RewardConfig" format=3]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="row"]

[ext_resource type="Script" path="res://Scripts/Config/Specializations/WindDomainBehaviorDefinition.cs" id="behavior_definition"]

[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/SpecializationRewardEffect.cs" id="specialization_effect"]

[sub_resource type="Resource" id="behavior_definition"]
script = ExtResource("behavior_definition")
Damage = 15
Radius = 5
TickInterval = 0.5
HoverExtensionSeconds = 2
HoverExtensionInterval = 1
ContactHeight = 3


[sub_resource type="Resource" id="specialization_effect"]
script = ExtResource("specialization_effect")
Definition = SubResource("behavior_definition")

[resource]
script = ExtResource("row")
NumericId = 1244
Id = "evo_wind_domain"
DisplayName = "风之领域"
RewardKind = 1
MaxStacks = 1
Effects = [SubResource("specialization_effect")]
Specialization = 11
DescriptionTemplate = "浮空时下方地面产生半径{SpecializationBehavior.Radius}米的旋风；接触时每{SpecializationBehavior.HoverExtensionInterval}秒延长浮空{SpecializationBehavior.HoverExtensionSeconds}秒。旋风每{SpecializationBehavior.TickInterval}秒造成{SpecializationBehavior.Damage}伤害，进入旋风的双方投掷物减速75%。"
Requires = PackedStringArray("rune_wind_seal")

Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"

NameKey = "content.evo_wind_domain.name"

DescriptionKey = "content.evo_wind_domain.description"
