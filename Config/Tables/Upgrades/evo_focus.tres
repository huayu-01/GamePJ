Id = "evo_focus"
DisplayName = "专一"
DescriptionTemplate = "武技2只掷出一把飞刀，将本次其余飞刀的基础伤害全部合并；蓄力增加的数量也转为这一发的伤害。"
Note = "064：保持单发；按照未压缩的基础/蓄力/增生发数合并直接弹体基础伤害，补偿系数1。与心流叠加时每轮仍单发，获取顺序无关；派生命中特效不按原发数复制。"

NameKey = "content.evo_focus.name"

DescriptionKey = "content.evo_focus.description"
