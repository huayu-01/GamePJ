[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/StatRewardEffect.cs" id="stats"]
[ext_resource type="Script" path="res://Scripts/Config/StatOverride.cs" id="modifier"]
[sub_resource type="Resource" id="size"]
script = ExtResource("scale")
SizeIncrease = 0.2
[sub_resource type="Resource" id="health_value"]
