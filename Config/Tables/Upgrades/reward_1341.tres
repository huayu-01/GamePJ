[resource]
script = ExtResource("row")
NumericId = 1341
DisplayName = "巨化"
DescriptionTemplate = "体型增加{Effects.0.SizeIncrease:0%}，最大生命值增加{Effects.1.Modifiers.0.Value:0}。"
