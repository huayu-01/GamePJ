DescriptionKey = "content.1341.description"
RewardKind = 2
MaxStacks = 1
Weight = 1
Effects = [SubResource("size"), SubResource("health")]
Note = "后续构筑.txt：通用异化，无符文或武器前置，只能获取一次。放大单位身体/模型/攻击体，TopLevel镜头独立；撤销时只移除自己的体型和生命修正。"
