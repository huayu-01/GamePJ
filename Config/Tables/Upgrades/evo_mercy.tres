[gd_resource type="Resource" script_class="RewardConfig" format=3]

[ext_resource type="Script" path="res://Scripts/Config/StatOverride.cs" id="1_stat"]
[ext_resource type="Resource" path="res://Config/Tables/UpgradePools/pool_scythe.tres" id="1_pool"]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="2_row"]

[sub_resource type="Resource" id="Resource_m0"]
script = ExtResource("1_stat")
Stat = "DamageMultiplier"
Operation = 1
Value = 1.5

[resource]
script = ExtResource("2_row")
RewardKind = 1
MaxStacks = 1
Modifiers = [SubResource("Resource_m0")]
RequiredCharacterIds = PackedStringArray("chr_weapon_master")
Pool = ExtResource("1_pool")
Id = "evo_mercy"
DisplayName = "怜悯"
DescriptionTemplate = "武技1 的伤害增加 50%"
Note = "[P5b 新增行] 文档第 141 行（进化池 <B2限定>）「怜悯:武技1现在只会释放最后一刀且伤害增加{50}%」。**只接了后半**（伤害 +50%，文档明确值；DamageMultiplier 由 MeleeComboAbility.Strike 消费）。⚠️ 前半「只会释放最后一刀」需要"跳过前几段"的新通路（连招从第 N 段起手），P5b **未接** —— 见 docs/upgrades.md §7。"
