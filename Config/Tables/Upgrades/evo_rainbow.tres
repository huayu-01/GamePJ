Id = "evo_rainbow"
DisplayName = "气贯长虹"
DescriptionTemplate = "武技2不能手动召回，落地立刻自动收回，全部蓄力时间缩短50%"
Note = "J16：强类型引用长虹贯日，禁再次按键手动召回，真实World落地同帧开始回手；基础1→0.5秒、每档0.25→0.125秒、总上限2→1秒，仍四档1.8倍。沿用往返各一次真实伤害、回手武技1解锁及换装还原。"
