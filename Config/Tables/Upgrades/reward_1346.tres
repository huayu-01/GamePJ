[resource]
script = ExtResource("row")
NumericId = 1346
DisplayName = "天降空投"
NameKey = "content.1346.name"
DescriptionKey = "content.1346.description"
DescriptionTemplate = "战斗中每{Effects.0.IntervalSeconds}秒在周围{Effects.0.MinRadius}～{Effects.0.MaxRadius}米有效位置落下一份补给，留场{Effects.0.PickupLifetime}秒。补给包含生命、力量、护甲、速度、急速、碎片；死战还可出现经验。"
RewardKind = 2
Weight = 1
MaxStacks = 1
Effects = [SubResource("effect")]

Note = "构筑2.0，验收069。未明确距离按米设可调首版；来源、派生与单次结算由独立效果组件维护。"
