[gd_resource type="Resource" script_class="RewardConfig" format=3]

[ext_resource type="Resource" path="res://Config/Tables/UpgradePools/pool_spirit_sword.tres" id="1_pool"]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="2_row"]
[ext_resource type="Script" path="res://Scripts/Config/SkillEnhancementTuning.cs" id="3_tuning"]
[ext_resource type="Resource" path="res://Config/Tables/Skills/skl_b1_w1_2.tres" id="4_skill"]

[sub_resource type="Resource" id="Enhancement"]
script = ExtResource("3_tuning")
TargetAbility = ExtResource("4_skill")
KillExtensionSeconds = 2.0

[resource]
script = ExtResource("2_row")
RewardKind = 1
MaxStacks = 1
ApplyHandler = "SkillEnhancement"
SkillEnhancement = SubResource("Enhancement")
RequiredCharacterIds = PackedStringArray("chr_weapon_master")
Pool = ExtResource("1_pool")
Id = "evo_great_draw"
DisplayName = "灵能汲取"
DescriptionTemplate = "击杀敌人后，延长当前灵剑持续时间{SkillEnhancement.KillExtensionSeconds:0.##}秒。"
Note = "J42替换大拔刀术，保留原Id和灵剑进化池引用。仅本人的真实敌对击杀续时；没有灵剑或已到期时不储存、不复活。不会修改伤害或范围。"
