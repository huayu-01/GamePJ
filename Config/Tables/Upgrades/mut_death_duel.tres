[gd_resource type="Resource" script_class="RewardConfig" load_steps=7 format=3]

[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="row"]
[ext_resource type="Script" path="res://Scripts/Config/ParamEntry.cs" id="param"]

[sub_resource type="Resource" id="p_Cooldown"]
script = ExtResource("param")
Key = "Cooldown"
Value = 20
Note = "机制参数；原文未给的数值为可调预设，文案共读此值。"

[sub_resource type="Resource" id="p_Duration"]
script = ExtResource("param")
Key = "Duration"
Value = 5
Note = "机制参数；原文未给的数值为可调预设，文案共读此值。"

[sub_resource type="Resource" id="p_HealFraction"]
script = ExtResource("param")
Key = "HealFraction"
Value = 0.3
Note = "机制参数；原文未给的数值为可调预设，文案共读此值。"

[sub_resource type="Resource" id="p_RequiredKills"]
script = ExtResource("param")
Key = "RequiredKills"
Value = 3
Note = "机制参数；原文未给的数值为可调预设，文案共读此值。"

[resource]
script = ExtResource("row")
Id = "mut_death_duel"
DisplayName = "死斗"
RewardKind = 2
MaxStacks = 1
ApplyHandler = "Specialization"
Specialization = 5
HandlerParams = [SubResource("p_Cooldown"), SubResource("p_Duration"), SubResource("p_HealFraction"), SubResource("p_RequiredKills")]
DescriptionTemplate = "致命伤后保持当前状态；{Duration}秒内击杀{RequiredKills}名敌人可避免死亡并恢复{HealFraction:0%}生命，冷却{Cooldown}秒。"
Requires = PackedStringArray("战神刻印")
Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"
