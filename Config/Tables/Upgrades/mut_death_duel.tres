[gd_resource type="Resource" script_class="RewardConfig" format=3]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="row"]
[ext_resource type="Script" path="res://Scripts/Config/Specializations/DeathDuelBehaviorDefinition.cs" id="definition"]
[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/SpecializationRewardEffect.cs" id="specialization_effect"]

[sub_resource type="Resource" id="definition"]
script = ExtResource("definition")
Duration = 5
Cooldown = 20
RequiredKills = 3
HealFraction = 0.3

[sub_resource type="Resource" id="specialization_effect"]
script = ExtResource("specialization_effect")
Definition = SubResource("definition")

[resource]
script = ExtResource("row")
NumericId = 1255
Id = "mut_death_duel"
DisplayName = "死斗"
RewardKind = 2
MaxStacks = 1
Effects = [SubResource("specialization_effect")]
Specialization = 5
DescriptionTemplate = "致命伤后保持当前状态；{SpecializationBehavior.Duration}秒内击杀{SpecializationBehavior.RequiredKills}名敌人可避免死亡并恢复{SpecializationBehavior.HealFraction:0%}生命，冷却{SpecializationBehavior.Cooldown}秒。"
Requires = PackedStringArray("rune_war_seal")
Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用独立定义中的可调预设。"

NameKey = "content.mut_death_duel.name"

DescriptionKey = "content.mut_death_duel.description"
