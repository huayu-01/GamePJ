[ext_resource type="Resource" path="res://Config/Tables/UpgradePools/pool_spirit_sword.tres" id="1_pool"]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="2_row"]

[resource]
script = ExtResource("2_row")
RewardKind = 1
MaxStacks = 1
RequiredCharacterIds = PackedStringArray("chr_weapon_master")
Pool = ExtResource("1_pool")
Id = "evo_golden_qi"
DisplayName = "金光术"
DescriptionTemplate = "武技1 每次攻击额外发射一道剑气"
Note = "⚠️ 占位行（机制未接）：文档第 125 行（进化池 <B1限定>）「金光术:武技1的每次攻击都会额外发射一道剑气」。**这一行现在没有任何效果** —— 它要的是 MeleeComboAbility 在每一段命中时额外生成一道剑气（新投射物通路：场景引用 + 伤害取当段值 + 朝向前方），P5b 没做。池子/限定/前置三层判定是齐的（它会在正确的人手上出现），但抽到之后不生效 —— 见 docs/upgrades.md §7 的未接清单。"
