MaxStacks = 1
Effects = [SubResource("specialization_effect")]
Specialization = 16
DescriptionTemplate = "奔跑路径上每{SpecializationBehavior.Interval}秒留下半大小旋风（半径{SpecializationBehavior.Radius}米），持续{SpecializationBehavior.Duration}秒，每{SpecializationBehavior.TickInterval}秒造成{SpecializationBehavior.Damage}伤害。"
Requires = PackedStringArray("rune_wind_seal")
Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"

