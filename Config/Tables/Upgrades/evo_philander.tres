[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="2_row"]

[sub_resource type="Resource" id="Resource_charge"]
script = ExtResource("1_tuning")
TargetAbility = ExtResource("3_skill")
StepTimeScale = 0.5
SeekDistinctHostiles = true
HomingRange = 40.0
HomingTurnRateDegrees = 720.0

[resource]
script = ExtResource("2_row")
RewardKind = 1
MaxStacks = 1
ApplyHandler = "ChargeBehavior"
ChargeBehavior = SubResource("Resource_charge")
RequiredCharacterIds = PackedStringArray("chr_hunter")
Pool = ExtResource("1_pool")
Excludes = PackedStringArray("evo_focus")
Id = "evo_philander"
DisplayName = "花心"
DescriptionTemplate = "武技2后置蓄力时间减半，射出的箭会追踪敌人，优先分配给不同目标"
Note = "J21：只缩短短弩武技2后置间隔0.2→0.1秒，基础0.4和3个后置档不变；齐射先给不同有效敌人各一支，剩余箭循环分配，失效目标允许重新索敌。无须标记，不影响武技1。追踪40米／每秒720度为文档未给的可调预设；实体仍受World碰撞阻挡。"
