Id = "evo_philander"
DisplayName = "花心"
DescriptionTemplate = "武技2后置蓄力时间减半，且射出的箭会自己追踪目标"
Note = "[P5 新增行] 文档第 79 行（进化池 <A2限定>）「花心:武技2后置蓄力时间减半,且射出的箭会自己追踪目标(尽可能选中更多的敌人),互斥:专一」。★ 落地的是\"后置蓄力时间减半\"（ChargeStepSecondsMultiplier = 0.5，消费者 Ability.ChargeStepSecondsEffective）；「射出的箭会自己追踪目标」**没有实现**（追踪靠技能行的 HomingStatusId 字符串列，StatSheet 是浮点表、没有字符串键的通路；要做得加一个\"授予追踪\"的处理器）。"
