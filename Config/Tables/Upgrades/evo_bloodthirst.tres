[resource]
script = ExtResource("row")
NumericId = 1217
Id = "evo_bloodthirst"
DisplayName = "嗜血"
RewardKind = 1
MaxStacks = 1
Effects = [SubResource("specialization_effect")]
Specialization = 14
DescriptionTemplate = "每次击杀在{SpecializationBehavior.Duration}秒内逐渐恢复{SpecializationBehavior.HealFraction:0%}最大生命，并提高{SpecializationBehavior.CritChance:0%}暴击率；连续击杀刷新暴击持续时间。"
Requires = PackedStringArray("rune_war_seal")
Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用独立定义中的可调预设。"

NameKey = "content.evo_bloodthirst.name"

DescriptionKey = "content.evo_bloodthirst.description"
