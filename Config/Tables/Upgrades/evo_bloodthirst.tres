[gd_resource type="Resource" script_class="RewardConfig" load_steps=6 format=3]

[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="row"]
[ext_resource type="Script" path="res://Scripts/Config/ParamEntry.cs" id="param"]

[sub_resource type="Resource" id="p_CritChance"]
script = ExtResource("param")
Key = "CritChance"
Value = 0.1
Note = "机制参数；原文未给的数值为可调预设，文案共读此值。"

[sub_resource type="Resource" id="p_Duration"]
script = ExtResource("param")
Key = "Duration"
Value = 5
Note = "机制参数；原文未给的数值为可调预设，文案共读此值。"

[sub_resource type="Resource" id="p_HealFraction"]
script = ExtResource("param")
Key = "HealFraction"
Value = 0.05
Note = "机制参数；原文未给的数值为可调预设，文案共读此值。"

[resource]
script = ExtResource("row")
Id = "evo_bloodthirst"
DisplayName = "嗜血"
RewardKind = 1
MaxStacks = 1
ApplyHandler = "Specialization"
Specialization = 14
HandlerParams = [SubResource("p_CritChance"), SubResource("p_Duration"), SubResource("p_HealFraction")]
DescriptionTemplate = "每次击杀在{Duration}秒内逐渐恢复{HealFraction:0%}最大生命，并提高{CritChance:0%}暴击率；连续击杀刷新暴击持续时间。"
Requires = PackedStringArray("战神刻印")
Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"
