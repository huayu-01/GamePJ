[gd_resource type="Resource" script_class="RewardConfig" format=3]

[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="2_row"]
[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/AbilityTuningRewardEffect.cs" id="effect_tuning"]
[ext_resource type="Script" path="res://Scripts/Config/AbilityChargesTuning.cs" id="charges_tuning"]
[ext_resource type="Resource" path="res://Config/Tables/Skills/skl_a1_skill_1.tres" id="charges_target"]

[sub_resource type="Resource" id="Resource_charges_tuning"]
script = ExtResource("charges_tuning")
TargetAbility = ExtResource("charges_target")
MaxCharges = 3
RechargeSeconds = 0.5

[sub_resource type="Resource" id="Resource_effect_tuning"]
script = ExtResource("effect_tuning")
Tuning = SubResource("Resource_charges_tuning")

[resource]
script = ExtResource("2_row")
NumericId = 1236
RewardKind = 1
MaxStacks = 1
Effects = [SubResource("Resource_effect_tuning")]
RequiredCharacterIds = PackedStringArray("chr_hunter")
Id = "evo_spare_dodge"
DisplayName = "有备无患"
DescriptionTemplate = "后撤现在可以叠 3 层"
Note = "[P5b 新增行] 文档第 54 行（进化池 <A限定>）「有备无患:后撤现在可叠3层」。层数机制是 P2 就备好的（Ability.MaxCharges / RechargeSeconds，见 docs/abilities.md §3）。消费者：P5b 新加的 AbilityOverride 处理器 —— 它按**技能行 Id** 找到能力，再按表里的键值对覆盖 [Export] 字段（不写死任何一个字段名与数值）。⚠️ 每层回复间隔文档没写 → 预设 0.5s（= 文档第 13 行「技能层数：每次使用技能消耗一层，间隔 0.5s」）。"

NameKey = "content.evo_spare_dodge.name"

DescriptionKey = "content.evo_spare_dodge.description"
