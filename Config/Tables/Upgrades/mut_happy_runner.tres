[resource]
script = ExtResource("row")
NumericId = 1263
Id = "mut_happy_runner"
DisplayName = "快乐小子"
RewardKind = 2
MaxStacks = 1
Effects = [SubResource("definition")]
DescriptionTemplate = "奔跑时接触普通敌人会轻推开对方，不造成伤害；同一敌人每{Effects.0.PushCooldown}秒最多推一次。连续{Effects.0.DamageFreeSeconds}秒未受伤后，奔跑每秒恢复{Effects.0.HealPerSecond}点生命。"
Note = "J33用户确认：单位恢复实体碰撞，快乐小子以奔跑轻推普通敌人替换穿透；不推动首领。10秒／每秒1生命来自原文；推力5米每秒与单目标0.5秒间隔为表内可调预设。"

NameKey = "content.mut_happy_runner.name"

DescriptionKey = "content.mut_happy_runner.description"
