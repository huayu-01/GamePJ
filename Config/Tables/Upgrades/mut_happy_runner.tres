NameKey = "content.mut_happy_runner.name"
DescriptionTemplate = "奔跑时接触普通敌人会短距离击退并造成{Effects.0.ImpactDamage}点碰撞伤害；同一敌人每{Effects.0.PushCooldown}秒最多触发一次。连续{Effects.0.DamageFreeSeconds}秒未受伤后，奔跑每秒恢复{Effects.0.HealPerSecond}点生命。"
DescriptionKey = "content.mut_happy_runner.description"
Note = "J33用户确认：单位恢复实体碰撞，快乐小子以奔跑轻推普通敌人替换穿透；不推动首领。10秒／每秒1生命来自原文；推力5米每秒与单目标0.5秒间隔为表内可调预设；碰撞伤害8点为可调预设。"
