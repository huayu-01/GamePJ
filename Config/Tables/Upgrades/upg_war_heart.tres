[gd_resource type="Resource" script_class="RewardConfig" format=3]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="row"]
[ext_resource type="Resource" path="res://Config/Tables/Upgrades/upg_hard.tres" id="hard"]
[ext_resource type="Resource" path="res://Config/Tables/Upgrades/upg_hard_plus.tres" id="hard1"]
[ext_resource type="Resource" path="res://Config/Tables/Upgrades/upg_hard_plus2.tres" id="hard2"]
[ext_resource type="Script" path="res://Scripts/Config/StatOverride.cs" id="stat"]

[ext_resource type="Script" path="res://Scripts/Config/Specializations/WarHeartBehaviorDefinition.cs" id="behavior_definition"]

[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/SpecializationRewardEffect.cs" id="specialization_effect"]
[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/StatRewardEffect.cs" id="specialization_stats"]

[sub_resource type="Resource" id="m_0"]
script = ExtResource("stat")
Stat = "MoveSpeedMultiplier"
Operation = 1
Value = 1.3

[sub_resource type="Resource" id="m_1"]
script = ExtResource("stat")
Stat = "DamageMultiplier"
Operation = 1
Value = 1.5

[sub_resource type="Resource" id="m_2"]
script = ExtResource("stat")
Stat = "CritChanceAdd"
Operation = 0
Value = 0.2

[sub_resource type="Resource" id="behavior_definition"]
script = ExtResource("behavior_definition")
ConversionRatio = 2
ConvertedRewards = [ExtResource("hard"), ExtResource("hard1"), ExtResource("hard2")]


[sub_resource type="Resource" id="specialization_effect"]
script = ExtResource("specialization_effect")
Definition = SubResource("behavior_definition")

[sub_resource type="Resource" id="specialization_stats"]
script = ExtResource("specialization_stats")
Modifiers = [SubResource("m_0"), SubResource("m_1"), SubResource("m_2")]

[resource]
script = ExtResource("row")
NumericId = 1316
Id = "upg_war_heart"
DisplayName = "战斗之心"
RewardKind = 0
MaxStacks = 1
Effects = [SubResource("specialization_stats"), SubResource("specialization_effect")]
Specialization = 21
DescriptionTemplate = "移速×{Modifiers.MoveSpeedMultiplier:0.##}、攻击力×{Modifiers.DamageMultiplier:0.##}、暴击率+{Modifiers.CritChanceAdd:0%}；所有坚硬及其后续等级按1:{SpecializationBehavior.ConversionRatio}转为爆伤。"
Requires = PackedStringArray("rune_war_seal")

Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"

NameKey = "content.upg_war_heart.name"

DescriptionKey = "content.upg_war_heart.description"
