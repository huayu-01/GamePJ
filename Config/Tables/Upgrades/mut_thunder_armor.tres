Value = 10
Note = "机制参数；原文未给的数值为可调预设，文案共读此值。"

[resource]
script = ExtResource("row")
Id = "mut_thunder_armor"
DisplayName = "雷凯"
RewardKind = 2
MaxStacks = 1
ApplyHandler = "Specialization"
Specialization = 2
HandlerParams = [SubResource("p_Damage"), SubResource("p_Jumps"), SubResource("p_Range"), SubResource("p_ReflectDamage")]
DescriptionTemplate = "护甲受伤或格挡时反伤{ReflectDamage}并触发闪电链：最多{Jumps}个目标、每次{Damage}伤害。"
Requires = PackedStringArray("雷之印")
Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"
