[gd_resource type="Resource" script_class="RewardConfig" format=3]

[ext_resource type="Script" path="res://Scripts/Config/ParamEntry.cs" id="1_param"]
[ext_resource type="Resource" path="res://Config/Tables/UpgradePools/pool_bow.tres" id="1_pool"]
[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="2_row"]
[ext_resource type="Resource" path="res://Config/Tables/Skills/skl_a3_w1_1.tres" id="3_arrow"]

[sub_resource type="Resource" id="Resource_p0"]
script = ExtResource("1_param")
Key = "StatusId"
Value = "Mark"
Note = "挂 Mark（可叠加 5 层）"

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("1_param")
Key = "Duration"
Value = 6.0
Note = "标记时长（文档没写 → 预设 6s，与 eff_mark 的 Duration 一致）"

[sub_resource type="Resource" id="Resource_p2"]
script = ExtResource("1_param")
Key = "FlatBonus"
Value = 0.5
Note = "文档给的就是 {50}%：对被标记目标的所有伤害 ×1.5"

[sub_resource type="Resource" id="Resource_p3"]
script = ExtResource("1_param")
Key = "PerStackBonus"
Note = "心眼是固定 50%，不按层数加算 → 留 0"

[resource]
script = ExtResource("2_row")
RewardKind = 1
MaxStacks = 1
ApplyHandler = "MarkedBonus"
RequiredEventAbility = ExtResource("3_arrow")
HandlerParams = [SubResource("Resource_p0"), SubResource("Resource_p1"), SubResource("Resource_p2"), SubResource("Resource_p3")]
RequiredCharacterIds = PackedStringArray("chr_hunter")
Pool = ExtResource("1_pool")
Id = "evo_mindseye"
DisplayName = "心眼"
DescriptionTemplate = "你的箭会给命中的敌人贴上标记；你对被标记的敌人造成的伤害提高 50%"
Note = "[J8 重做行] 文档第 95 行（进化池 <A3限定>）「心眼:你的箭会为命中的敌人施加标记,你对被标记的敌人造成的伤害提高{50}%」。★ 旧实现的病根与「发散」同一条：复用 `BurnOnHit` 只加标记，且来源过滤只有「来源是自己」；按标记加伤那一半完全没接。★ 现在：① 加标来源 = `RequiredEventAbility`（强类型资源引用 `skl_a3_w1_1`，这张行是 <A3限定> = 弓，而弓的两个武技里**只有武技1「箭在弦上」会射出箭**；刹那之眼的标记是它自己的机制）→ 后撤／能量波／近战等**非箭伤害不加标**；② 加伤 `BonusAgainstAbility` **留空 = 玩家的各种伤害都吃**（实测证据里用能量掌武技2 的能量波验证过 ×1.5）；③ 敌人／召唤物／其他单位的伤害**不吃**（规则挂在**玩家**身上而不是目标身上，`AttackInstance.RollHit` 问的是攻击者）。★ 结算顺序：按**本次命中之前**已有的标记结算（用户 2026-10-17 裁定）→ 第一次加标那一击不加伤，从下一击起 ×1.5。★ 固定 50%（文档给的就是 50），不按层数加算；层数上限仍由效果表 `eff_mark.MaxStacks` 管。"
