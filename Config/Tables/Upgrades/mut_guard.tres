[resource]
script = ExtResource("2_row")
NumericId = 1262
RewardKind = 2
MaxStacks = 1
Id = "mut_guard"
DisplayName = "护卫"
DescriptionTemplate = "奔跑时获得一次格挡，格挡破碎 5 秒后才可再次获取"
Note = "[P6d 新增行] 文档第 172 行（异化池，全角色通用）「护卫:奔跑时获得一次格挡,格挡破碎{5}秒后才可再次获取;」。★ 触发条件 = 文档第 19 行那条**全角色通用机制「奔跑」**：「奔跑(只有在移动状态时才可以按住shift键进入,移动的更快,释放其他任何状态或技能都会退出奔跑)」—— P6d 为此补了 `project.godot` 的 `sprint` 动作（Shift）+ `SprintController`（`Scripts/Combat/SprintController.cs`，只读共用类已公开的量，**没碰 CharacterMovement**）+ 角色表两列（`SprintInputAction` / `SprintSpeedMultiplier`）。★ 格挡走**既有**的 `BlockComponent`（战斗规则说明 §14 的独立防御模块），规则在玩家身上按需建一个名为 Block 的子节点 —— **不选这条增幅就不会有这个节点**（默认行为逐位不变）。★ 消费者：`GuardOnSprintRule`（`Scripts/Rewards/RewardCatalog.cs`）：轮询 `SprintController.IsSprinting` 授予格挡，订阅 `Unit.Damaged` 读 `DamageResult.Blocked` 判定"格挡破碎"。★ **文档只给了 {5}**：Cooldown=5 来自文档；`BlockDamageMultiplier = 0`（完全格挡）与 `FrontDotThreshold = 1`（不看正面）是**预设值**。"

NameKey = "content.mut_guard.name"

DescriptionKey = "content.mut_guard.description"

Effects = [SubResource("Resource_effect_0")]
