MaxStacks = 1
Modifiers = [SubResource("Resource_m0")]
RequiredCharacterIds = PackedStringArray("chr_weapon_master")
Pool = ExtResource("1_pool")
Id = "evo_light_leap"
DisplayName = "浮光跃金"
DescriptionTemplate = "跳跃高度提高"
Note = "[P5b 新增行] 文档第 162 行（进化池 <B3限定>）「浮光跃金:额外跳跃次数变为更高的跳跃高度,跳跃现在变为直接闪现至目标高度位置」。**只接了前半**（跳跃高度倍率，消费者 CharacterMovement.EffectiveJumpVelocity —— 与强化「攀高」同一个键）。⚠️ 后半「跳跃变为直接闪现至目标高度位置」需要新的位移通路（位移到目标高度），P5b **未接** —— 见 docs/upgrades.md §7。⚠️ 倍率文档没给 → 预设 ×1.25。"
