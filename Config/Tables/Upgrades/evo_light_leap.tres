[ext_resource type="Script" path="res://Scripts/Config/RewardConfig.cs" id="2_row"]

[resource]
script = ExtResource("2_row")
RewardKind = 1
MaxStacks = 1
ApplyHandler = "TeleportJump"
RequiredCharacterIds = PackedStringArray("chr_weapon_master")
Pool = ExtResource("1_pool")
Id = "evo_light_leap"
DisplayName = "浮光跃金"
DescriptionTemplate = "额外跳跃次数换成完整基础跳高，地面跳跃直接瞬移至目标高度"
Note = "J18：用户裁定每份额外次数加一份地面基础跳高，0/1/2/3次对应1/2/3/4倍；不使用普通额外跳0.5高度比例。按当前地面跳速与重力计算，真实身体向上TestMove检查World净空后瞬移，立即清垂直上升速度，自然下落；额外次数只作为高度来源，不能再空中跳。换装清理，无旧全局1.25跳速加成。"
