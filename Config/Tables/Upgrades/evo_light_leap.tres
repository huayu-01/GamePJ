Id = "evo_light_leap"
DisplayName = "浮光跃金"
DescriptionTemplate = "地面跳跃瞬移上升至基础跳高的{Effects.0.HeightMultiplier:0}倍，并获得{Effects.0.HoverSeconds:0.0}秒自动浮空；落的冷却减少{Effects.1.Tuning.CooldownReduction:0%}。按下落攻击键（默认Ctrl，可改键）取消浮空。"
Note = "039替代038参数：基础跳高3倍、0.5秒自动浮空，仅共通落冷却减半；撤销进化还原。"

NameKey = "content.evo_light_leap.name"

