[resource]
script = ExtResource("row")
Id = "evo_wind_sword"
DisplayName = "风剑"
RewardKind = 1
MaxStacks = 1
ApplyHandler = "Specialization"
Specialization = 15
HandlerParams = [SubResource("p_Damage"), SubResource("p_Interval"), SubResource("p_Lifetime"), SubResource("p_Radius"), SubResource("p_Range"), SubResource("p_Speed"), SubResource("p_TurnRate")]
DescriptionTemplate = "奔跑时每{Interval}秒朝周围敌人方向发射一枚旋风弹，造成{Damage}伤害。"
Requires = PackedStringArray("风之印")
SpecializationProjectile = ExtResource("projectile")
Note = "J32：后续构筑23项特化；明确数值遵循原文，n与未给尺寸／伤害采用本行可调预设。"
