[resource]
script = ExtResource("1_row")
OwnerCharacter = ExtResource("10_owner")
ModelPath = "res://Scenes/Weapons/Visuals/crossbow.tscn"
IconPath = "res://Assets/UI/Icons/Skills/ic_skill_bolts.svg"
Pool = ExtResource("4_pool")
ScenePath = "res://Scenes/Weapons/Pistol.tscn"
UsesWeaponComponent = false
AttackTags = PackedStringArray("Projectile", "Arrow", "Physical")
Damage = 0.0
FireInterval = 0.5
MagazineSize = 1
ReloadTime = 0.1
AutoReloadDelay = 999.0
SpreadDegrees = 0.0
AimSpreadScale = 0.0
MultiShotSpreadDegrees = 0.0
ProjectilesPerShot = 1
BasePierce = 0
Knockback = 0.0
CritChance = 0.05
CritMultiplier = 2.0
ProjectileSpeed = 200.0
MaxLifetime = 3.0
AimFov = 55.0
Automatic = false
Skills = [ExtResource("2_skl"), ExtResource("3_skl")]
Id = "wpn_crossbow"
Slot = 5
DisplayName = "短弩"
DescriptionTemplate = "发射弩箭：飞行一段距离后下坠（射速决定什么时候开始下坠），射速较高时造成击退。武技1 散射三发 / 武技2 蓄力散射（最多 9 支）。"
Note = "[新增行·P3 · P6a 清理] 角色 A 武器 2。⚠️ 与能量掌同一条纪律：**不走 Weapon 组件的开火**（那套有弹匣/装填），发射由本行 Skills 里那两个武技行完成 —— 这件事现在由**本行自己的** `UsesWeaponComponent = false` 表达（P6a 起；原来靠角色行的 `WeaponEnabled`，那一列已删，用户说他没设计过"出征时按角色行把枪收起来"）。这一行的作用是身份 + 攻击标签 + 暴击基准 + 弹速 + **指向自己的武技行**（Skills 列 = 武器 → 武技的正向引用，见 WeaponConfig.Skills 的注释：武技属于武器，挂在角色行上会让换武器时上一把的武技留在按键上）。ScenePath 暂用 Pistol.tscn（手上模型，后续换 mesh 即可）。"
