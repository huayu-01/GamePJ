[gd_resource type="Resource" script_class="RuneConfig" format=3]

[ext_resource type="Script" path="res://Scripts/Config/ParamEntry.cs" id="1_param"]
[ext_resource type="Script" path="res://Scripts/Config/StatOverride.cs" id="2_stat"]
[ext_resource type="Script" path="res://Scripts/Config/RuneConfig.cs" id="3_row"]

[sub_resource type="Resource" id="Resource_p0"]
script = ExtResource("1_param")
Key = "Armor"
Value = 20
Note = "初始护甲（文档为 {n}）"

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("1_param")
Key = "ArmorPerKills"
Value = 10
Note = "每多少击杀 +1 护甲（文档为第二个 {n}）"

[sub_resource type="Resource" id="Resource_p2"]
script = ExtResource("1_param")
Key = "ArmorPerTrigger"
Value = 1
Note = "每满一次击杀数加多少甲"

[sub_resource type="Resource" id="Resource_m0"]
script = ExtResource("2_stat")
Stat = "HealMultiplier"
Operation = 1
Value = 0.0

[resource]
script = ExtResource("3_row")
RewardKind = 0
MaxStacks = 1
ApplyHandler = "RuneEffect"
Modifiers = [SubResource("Resource_m0")]
HandlerParams = [SubResource("Resource_p0"), SubResource("Resource_p1"), SubResource("Resource_p2")]
Slot = 4
UnlocksRequires = Array[String]([])
Id = "rune_death_armor"
DisplayName = "死铠"
DescriptionTemplate = "护甲 +20，每 10 击杀再 +1 护甲；无法恢复生命值。"
Note = "[J11 新增行·符文] 文档第 6 行「死铠:获得{n}护甲,每{n}击杀获得1护甲,无法恢复生命值」——**两个 {n} 文档都没给数**（用户 2026-10-17 只说明了「前者=初始护甲量、后者=击杀数」）。预设 **初始护甲 20**（= 猎手一局的既有初始护甲 20，等于「多一管甲」）+ **每 10 击杀 +1**（一场节点通常 10~30 杀，节奏上大约每 1~2 个节点涨 1 点）。「无法恢复生命值」= StatSheet 新键 `HealMultiplier`（基础值 1，`Unit.Heal` 里乘），×0 即彻底禁疗（包括节点的恢复节点、吸血、灵魂拾取）；不是只在 UI 上显示禁用。护甲走既有 `Unit.GrantArmor`，每 N 杀加甲走新规则 `RuneArmorOnKillRule`（一个类服务所有这类符文行，数字全在表里）。"
