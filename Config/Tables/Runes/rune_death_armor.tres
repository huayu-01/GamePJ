[gd_resource type="Resource" script_class="RuneConfig" format=3]

[ext_resource type="Script" path="res://Scripts/Config/StatOverride.cs" id="2_stat"]
[ext_resource type="Script" path="res://Scripts/Config/RuneConfig.cs" id="3_row"]

[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/StatRewardEffect.cs" id="effect_0"]
[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/GrantArmorRewardEffect.cs" id="effect_1"]
[ext_resource type="Script" path="res://Scripts/Config/RewardEffects/ArmorOnKillRewardEffect.cs" id="effect_2"]

[sub_resource type="Resource" id="Resource_m0"]
script = ExtResource("2_stat")
Stat = "HealMultiplier"
Operation = 1
Value = 0.0

[sub_resource type="Resource" id="Resource_effect_0"]
script = ExtResource("effect_0")
Modifiers = [SubResource("Resource_m0")]

[sub_resource type="Resource" id="Resource_effect_1"]
script = ExtResource("effect_1")
Armor = 20

[sub_resource type="Resource" id="Resource_effect_2"]
script = ExtResource("effect_2")
KillsPerTrigger = 10
ArmorPerTrigger = 1

[resource]
script = ExtResource("3_row")
NumericId = 1127
RewardKind = 0
MaxStacks = 1
Slot = 4
UnlocksRequires = Array[String]([])
Id = "rune_death_armor"
DisplayName = "死铠"
DescriptionTemplate = "护甲 +{Effects.1.Armor:0.#}，每 {Effects.2.KillsPerTrigger:0} 次本人击杀再 +{Effects.2.ArmorPerTrigger:0.#} 护甲；无法恢复生命值。"
Note = "[J11 新增行·符文] 文档第 6 行「死铠:获得{n}护甲,每{n}击杀获得1护甲,无法恢复生命值」——**两个 {n} 文档都没给数**（用户 2026-10-17 只说明了「前者=初始护甲量、后者=击杀数」）。预设 **初始护甲 20**（= 猎手一局的既有初始护甲 20，等于「多一管甲」）+ **每 10 击杀 +1**（一场节点通常 10~30 杀，节奏上大约每 1~2 个节点涨 1 点）。「无法恢复生命值」= StatSheet 新键 `HealMultiplier`（基础值 1，`Unit.Heal` 里乘），×0 即彻底禁疗（包括节点的恢复节点、吸血、灵魂拾取）；不是只在 UI 上显示禁用。护甲走既有 `Unit.GrantArmor`，每 N 杀加甲走新规则 `RuneArmorOnKillRule`（一个类服务所有这类符文行，数字全在表里）。"
IconPath = "res://Assets/UI/Icons/Runes/rune_death_armor.svg"

NameKey = "content.rune_death_armor.name"

DescriptionKey = "content.rune_death_armor.description"

Effects = [SubResource("Resource_effect_0"), SubResource("Resource_effect_1"), SubResource("Resource_effect_2")]
