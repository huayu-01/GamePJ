Slot = 8
UnlocksRequires = Array[String]([])
Id = "rune_flying_wing"
DisplayName = "飞翼"
DescriptionTemplate = "起跳速度 ×{Modifiers.JumpVelocityMultiplier:0.##}；正常下落速度上限 ×{Modifiers.MaxFallSpeedMultiplier:0.##}；下落攻击速度 ×{Modifiers.DiveSpeedMultiplier:0.##}。"
Note = "J27补全后续构筑原文飞翼：跳跃更高、上升更快、正常下落更慢、下落攻击更快。原文未给数值；沿用起跳×1.3、正常下落上限×0.8，下冲×1.3为可调预设，平衡后置。下冲在真实Action读取倍率后冻结整个速度矢量，保留长枪斜向垂直分量及既有伤害公式，不改正常下落夹速。说明共读Modifiers.Value。"
