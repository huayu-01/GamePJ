[resource]
script = ExtResource("2_row")
NumericId = 1133
RewardKind = 0
MaxStacks = 1
Slot = 11
UnlocksRequires = Array[String]([])
Id = "rune_pixie"
DisplayName = "小精灵"
DescriptionTemplate = "获得一只围着玩家转的小精灵，每 5 秒攻击 8 米内的一个敌人。"
Note = "[J11 新增行·符文] 文档第 14 行「小精灵:获得一个围着转的小精灵,小精灵每{5}秒的攻击周围的某个敌人」——**5 秒文档给了**，**每次伤害与索敌半径都没给**（「周围的某个敌人」连半径都没写）→ 预设 **伤害 20**（≈ 一次普通近战命中，5 秒一次不会喧宾夺主）+ **半径 8 米** + 绕行半径 1.6 米 + 90°/秒。实现 = `PixieCompanion`（挂玩家下的 `Node3D`，**不进物理世界、不进任何单位分组**，与「灵魂收割」的 `SoulPickup` 同一条纪律）：每帧按相位摆到玩家身侧，到点挑一个半径内最近的 `IsValidTarget` 敌人，走 `AttackInstance.RollHit` + `Unit.ReceiveHit` 统一结算（所以它吃玩家的伤害/暴击/狙神/巨人等全部修正，不自成一套）。⚠️ 没有模型/动画资源，本批用一个自发光小球当占位表现（`Note` 如实登记）。"
IconPath = "res://Assets/UI/Icons/Runes/rune_pixie.svg"

NameKey = "content.rune_pixie.name"

DescriptionKey = "content.rune_pixie.description"

Effects = [SubResource("Resource_effect_0")]
