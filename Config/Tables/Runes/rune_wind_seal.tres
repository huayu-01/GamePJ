Id = "rune_wind_seal"
DisplayName = "风之印"
DescriptionTemplate = "技能冷却时间 +50%；携带时「风之印」派系的增幅可以被抽到。"
Note = "[J11 新增行·符文] 文档第 5 行「风之印:获得 风之印,技能冷却时间增加{50}%」——**文档给了 50%**（与雷之印/战神印同为「负面效果」那一类，用户 2026-10-17 确认）。实现 = 既有键 `CooldownMultiplier`（`Unit.SeedStats` 里基础值 1，消费者 `Ability.UnitCooldownMultiplier` → `EffectiveCooldown = Cooldown × 行级 × 单位级`），×1.5 = 冷却变长 50%，纯表驱动、零处理器。前置解锁 = `UnlocksRequires` 里填「风之印」。"
IconPath = "res://Assets/UI/Icons/Runes/rune_wind_seal.svg"
