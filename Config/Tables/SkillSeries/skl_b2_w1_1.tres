[resource]
script = ExtResource("1_row")
Entries = "ComboAnimations=Skill_B2_Scythe1|Skill_B2_Scythe2|Skill_B2_Scythe3;StepDamageScales=1|1.2|1.9;StepBoxSizes=3.2,1.8,3.4|3.2,1.8,3.4|7.2,1.8,0;StepBoxOffsets=1.7|1.7|0.0;StepActiveTimes=0.12|0.12|0.2;ComboWindowSeconds=0.5;ComboLoop=false;ComboNextEvent=ATK"
