[resource]
script = ExtResource("1_row")
Entries = "ComboAnimations=Skill_B1_Sword1|Skill_B1_Sword2|Skill_B1_Sword3|Skill_B1_Sword4|Skill_B1_Sword5;StepDamageScales=1|1.15|1.3|1.45|1.8;StepBoxSizes=2.2,1.6,2.8|2.3,1.6,2.8|2.4,1.6,3.0|2.2,1.6,2.8|2.8,1.8,3.2;StepBoxOffsets=1.4|1.4|1.5|1.4|1.6;StepActiveTimes=0.1|0.1|0.12|0.1|0.14;CutSceneNames=Bullet;CutExcludeSceneNames=EnergyWave;ComboWindowSeconds=0.45;ComboLoop=false;ComboNextEvent=ATK"
ItemType = "mixed"
ValueSeparatorText = "|"
Id = "skl_b1_w1_1"
DisplayName = "skl_b1_w1_1 的连招参数串"
Note = "角色 B 灵剑 武技1「破剑式」（skl_b1_w1_1）：5 段连招的参数串 —— ComboAnimations（5 段动画名）/ StepDamageScales / StepBoxSizes（每段命中盒，x 宽 y 高 z 长）/ StepBoxOffsets（前伸）/ StepActiveTimes（判定时长）/ CutSceneNames（可斩断的投射物来源场景名 = Bullet）/ CutExcludeSceneNames（斩不断的 = EnergyWave，文档：无法斩断能量波）。格式：名=值1|值2|值3;名2=…（见 AbilitySeries 的类注释：数组型参数在 Godot 的 C# 绑定里没有可靠的导出/反序列化路径，所以整串落进一个 string 字段）。文件名 = 技能行 Id，MeleeComboAbility 按约定路径读它。"
