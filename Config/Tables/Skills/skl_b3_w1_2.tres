[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_ReturnSpeed"]
script = ExtResource("2_param")
Key = "ReturnSpeed"
Value = 30
Note = "收回速度（m/s）"

[sub_resource type="Resource" id="p_MaxThrowDistance"]
script = ExtResource("2_param")
Key = "MaxThrowDistance"
Value = 12
Note = "★ 路径中线基准长度（米；蓄力每档 +20%）"

[sub_resource type="Resource" id="p_FlightSeconds"]
script = ExtResource("2_param")
Key = "FlightSeconds"
Value = 0.8
Note = "基准飞行时间（水平速度 = 距离 ÷ 它 → 路径延长就是速度变快）"

[sub_resource type="Resource" id="p_ArcGravity"]
script = ExtResource("2_param")
Key = "ArcGravity"
Value = 22
Note = "抛物线重力（m/s²）"

[sub_resource type="Resource" id="p_ArcPathSteps"]
script = ExtResource("2_param")
Key = "ArcPathSteps"
Value = 32.0
Note = "路径采样段数"

[sub_resource type="Resource" id="p_SpinDegreesPerSecond"]
script = ExtResource("2_param")
Key = "SpinDegreesPerSecond"
Value = 0
Note = "长枪沿速度方向飞行，落地后静止"

[sub_resource type="Resource" id="p_DamageInterval"]
script = ExtResource("2_param")
Key = "DamageInterval"
Value = 0.25
Note = "周期性伤害间隔（长枪飞行较快，给 0.25）"

[sub_resource type="Resource" id="p_DamageActiveTime"]
script = ExtResource("2_param")
Key = "DamageActiveTime"
Value = 0.12
Note = "每次判定的持续"

[sub_resource type="Resource" id="p_RecallOnSecondPress"]
script = ExtResource("2_param")
Key = "RecallOnSecondPress"
Value = true
Note = "★ 丢出去后可再次使用技能收回（文档）"

[sub_resource type="Resource" id="p_RecallDistance"]
script = ExtResource("2_param")
Key = "RecallDistance"
Value = 0
Note = "默认只在再次使用时收回，不靠近自动收回"

[sub_resource type="Resource" id="p_DamageOnReturn"]
script = ExtResource("2_param")
Key = "DamageOnReturn"
Value = true
Note = "★ 回来时能再次对路径中的敌人造成伤害（文档）"

[sub_resource type="Resource" id="p_ShowPath"]
script = ExtResource("2_param")
Key = "ShowPath"
Value = true
Note = "★ 路径可视化指示器（文档第 151 行）"

[sub_resource type="Resource" id="p_ContinuousPathDamage"]
script = ExtResource("2_param")
Key = "ContinuousPathDamage"
Value = true
Note = "飞出／回手各对沿途目标命中一次，静止时不持续刺伤"

[resource]
script = ExtResource("1_row")
ActionMovement = 2
HudIcon = ExtResource("e_hud_icon")
HudColor = Color(1, 0.76, 0.4, 1)
HudOrder = 40
NodeName = "AbilityWeapon6Skill2"
ClassHint = "SpearThrowAbility"
InputAction = "weapon_skill_2"
HoldToCharge = true
AnimName = "Skill_B3_Spear4"
AnimEvent = "ATK"
ChargeBaseSeconds = 1.0
ChargeStepSeconds = 0.25
ChargeStepScale = 1.2
ChargeMaxSeconds = 2.0
Aim = 2
Cooldown = 0.5
Windup = 0.0
Recover = 0.05
Id = "skl_b3_w1_2"
DisplayName = "长虹贯日"
DescriptionTemplate = "基础蓄力1秒，额外最多1秒，每0.25秒增强20%基础伤害、弹速和射程，最多1.8倍；朝准星落点抛出，超射程截到最远，落地静止，再次使用收回，回程再次造成路径伤害。"
Note = "用户确认：基础1秒＋额外最多1秒，每0.25秒按基础值加算20%，四档1.8倍；准星选地面落点，超水平射程截到最远。预览和真实飞行同源，碰World后静止，默认仅再次使用收回；往返各命中一次。临时复用突刺作为释放动作，独立动作待后续适配。"
Params = [SubResource("p_ReturnSpeed"), SubResource("p_MaxThrowDistance"), SubResource("p_FlightSeconds"), SubResource("p_ArcGravity"), SubResource("p_ArcPathSteps"), SubResource("p_SpinDegreesPerSecond"), SubResource("p_DamageInterval"), SubResource("p_DamageActiveTime"), SubResource("p_RecallOnSecondPress"), SubResource("p_RecallDistance"), SubResource("p_DamageOnReturn"), SubResource("p_ShowPath"), SubResource("p_ContinuousPathDamage")]
