[gd_resource type="Resource" script_class="AbilityConfig" format=3 uid="uid://cafy8lisvsfu7"]

[ext_resource type="Script" uid="uid://c12mw26vliwue" path="res://Scripts/Config/AbilityConfig.cs" id="1_row"]
[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_ThrowSpeed"]
script = ExtResource("2_param")
Key = "ThrowSpeed"
Value = 14
Note = "基准水平速度（m/s；蓄力按 ChargePowerScale 放大）"

[sub_resource type="Resource" id="p_ReturnSpeed"]
script = ExtResource("2_param")
Key = "ReturnSpeed"
Value = 30
Note = "收回速度（m/s）"

[sub_resource type="Resource" id="p_MaxThrowDistance"]
script = ExtResource("2_param")
Key = "MaxThrowDistance"
Value = 12
Note = "★ 路径中线基准长度（米；蓄力每档 +20%）"

[sub_resource type="Resource" id="p_FlightSeconds"]
script = ExtResource("2_param")
Key = "FlightSeconds"
Value = 0.8
Note = "基准飞行时间（水平速度 = 距离 ÷ 它 → 路径延长就是速度变快）"

[sub_resource type="Resource" id="p_ArcGravity"]
script = ExtResource("2_param")
Key = "ArcGravity"
Value = 22
Note = "抛物线重力（m/s²）"

[sub_resource type="Resource" id="p_ArcPathSteps"]
script = ExtResource("2_param")
Key = "ArcPathSteps"
Value = 32.0
Note = "路径采样段数"

[sub_resource type="Resource" id="p_SpinDegreesPerSecond"]
script = ExtResource("2_param")
Key = "SpinDegreesPerSecond"
Value = 1080
Note = "飞行自转（度/秒）"

[sub_resource type="Resource" id="p_DamageInterval"]
script = ExtResource("2_param")
Key = "DamageInterval"
Value = 0.25
Note = "周期性伤害间隔（长枪飞行较快，给 0.25）"

[sub_resource type="Resource" id="p_DamageActiveTime"]
script = ExtResource("2_param")
Key = "DamageActiveTime"
Value = 0.12
Note = "每次判定的持续"

[sub_resource type="Resource" id="p_RecallOnSecondPress"]
script = ExtResource("2_param")
Key = "RecallOnSecondPress"
Value = true
Note = "★ 丢出去后可再次使用技能收回（文档）"

[sub_resource type="Resource" id="p_RecallDistance"]
script = ExtResource("2_param")
Key = "RecallDistance"
Value = 1.8
Note = "靠近也收回"

[sub_resource type="Resource" id="p_DamageOnReturn"]
script = ExtResource("2_param")
Key = "DamageOnReturn"
Value = true
Note = "★ 回来时能再次对路径中的敌人造成伤害（文档）"

[sub_resource type="Resource" id="p_ShowPath"]
script = ExtResource("2_param")
Key = "ShowPath"
Value = true
Note = "★ 路径可视化指示器（文档第 151 行）"

[resource]
script = ExtResource("1_row")
NodeName = "AbilityWeapon6Skill2"
ClassHint = "SpearThrowAbility"
InputAction = "weapon_skill_2"
HoldToCharge = true
ChargeBaseSeconds = 1.0
ChargeStepSeconds = 0.25
ChargeStepScale = 1.2
ChargeMaxSeconds = 2.0
Aim = 2
Cooldown = 0.5
Windup = 0.0
Recover = 0.05
Id = "skl_b3_w1_2"
DisplayName = "长虹贯日"
DescriptionTemplate = "基础蓄力 {ChargeBaseSeconds:0.##}s，朝准星方向抛掷长枪，路径呈现抛物线（有路径可视化指示器）；每蓄力 {ChargeStepSeconds:0.##}s 增强伤害 {ChargeStepScale:0.##} 倍、弹速与路径中线同样 +20%，最多蓄力 {ChargeMaxSeconds:0.##}s；丢出去后可再次使用技能收回，回来时能再次对路径中的敌人造成伤害。"
Note = "[P4 新增行] 角色 B 武器3 长枪 武技2（文档 CD:0.5 / 基础蓄力 1s / 每 0.25s +20% 伤害·弹速·路径中线 / 最多蓄力 1 秒）。★ ChargeStepScale=1.2 → 每档 ×1.2（= +20%）。★ 「路径中线延长 20%」 是**非倍率维度**（它是长度）：水平速度按同一个倍率放大、飞行时间不变（见 SpearThrowAbility.Launch 的注释与 docs/abilities.md §8）。★ 抛物线形状与画出来的那条线**同源**（同一组参数调 DashPathIndicator.SampleArcToDistance）。"
Params = [SubResource("p_ThrowSpeed"), SubResource("p_ReturnSpeed"), SubResource("p_MaxThrowDistance"), SubResource("p_FlightSeconds"), SubResource("p_ArcGravity"), SubResource("p_ArcPathSteps"), SubResource("p_SpinDegreesPerSecond"), SubResource("p_DamageInterval"), SubResource("p_DamageActiveTime"), SubResource("p_RecallOnSecondPress"), SubResource("p_RecallDistance"), SubResource("p_DamageOnReturn"), SubResource("p_ShowPath")]
