[ext_resource type="Texture2D" path="res://Assets/UI/Icons/Skills/ic_skill_nova.svg" id="e_hud_icon"]
[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_a1_w1_2_0"]
script = ExtResource("2_param")
Key = "ProjectileScenePath"
Value = "res://Scenes/Combat/EnergyWave.tscn"
Note = "能量波预制体（直线 / 无下坠 / 穿透格挡）"

[sub_resource type="Resource" id="p_a1_w1_2_1"]
script = ExtResource("2_param")
Key = "Speed"
Value = 250.0
Note = "弹速（文档 武技2[憋个大的] 蓄力满：250）"

[sub_resource type="Resource" id="p_a1_w1_2_2"]
script = ExtResource("2_param")
Key = "Damage"
Value = 30.0
Note = "伤害（文档 武技2 蓄力满：30）"

[sub_resource type="Resource" id="p_a1_w1_2_3"]
script = ExtResource("2_param")
Key = "PerfectDamage"
Value = 40.0
Note = "★ 完美时机那一发的伤害**绝对值**（文档：40）。≤0 才会回落到 Damage；只有在「刚蓄满的 0.2s 窗口内松手」才吃它（见 docs/abilities.md）"

[sub_resource type="Resource" id="p_a1_w1_2_4"]
script = ExtResource("2_param")
Key = "PerfectSpeed"
Value = 400.0
Note = "★ 完美时机那一发的弹速**绝对值**（文档：400）"

[sub_resource type="Resource" id="p_a1_w1_2_5"]
script = ExtResource("2_param")
Key = "PerfectKnockback"
Value = 2.0
Note = "完美时机的额外击退（文档：「带略微的击退效果」）"

[sub_resource type="Resource" id="p_a1_w1_2_6"]
script = ExtResource("2_param")
Key = "MaxLifetime"
Value = 1.6
Note = "存活时间（秒）"

[sub_resource type="Resource" id="p_a1_w1_2_7"]
script = ExtResource("2_param")
Key = "BypassBlock"
Value = true
Note = "★ 子弹特性：能穿透格挡（无视格挡效果）"

[sub_resource type="Resource" id="p_a1_w1_2_8"]
script = ExtResource("2_param")
Key = "AttackTags"
Value = PackedStringArray("Projectile", "Energy", "Physical")
Note = "攻击标签（供增幅的武器标签匹配）"

[sub_resource type="Resource" id="p_a1_w1_2_9"]
script = ExtResource("2_param")
Key = "MaxAimDistance"
Value = 200.0
Note = "求「准星打到的世界点」时射线的最大长度（无命中时用它定方向）—— 与枪械 PlayerWeaponInput.MaxAimDistance 同一个 200，口径一致"

[resource]
script = ExtResource("1_row")
ActionMovement = 2
HudIcon = ExtResource("e_hud_icon")
HudColor = Color(1, 0.76, 0.4, 1)
HudOrder = 40
NodeName = "AbilityWeaponSkill2"
ClassHint = "EnergyWaveAbility"
InputAction = "weapon_skill_2"
HoldToCharge = true
AllowEarlyChargeRelease = true
EarlyReleaseDamageScale = 0.5
AnimName = "Skill_A1_ATK2"
AnimEvent = "ATK"
AnimSpeedScale = 0.2
ChargeBaseSeconds = 0.5
PerfectWindowSeconds = 0.2
Aim = 2
Cooldown = 1.0
Windup = 1.7
Recover = 0.1
Id = "skl_a1_w1_2"
DisplayName = "憋个大的"
DescriptionTemplate = "按住右键蓄力：蓄满 {ChargeBaseSeconds:0.##}s 后松手 = 伤害 {Damage:0} / 弹速 {Speed:0}；刚蓄满的 {PerfectWindowSeconds:0.##}s 内松手 = 完美时机（伤害 {PerfectDamage:0} / 弹速 {PerfectSpeed:0}）；未完成基础蓄力也可松手，造成基础伤害的 {EarlyReleaseDamageScale:0%}。"
Note = "角色 A 武器 1「能量掌」武技2（文档 CD:1 / 蓄力 30-250 / 完美时机 40-400，窗口 0.2s）。★ 蓄力的三段状态机（基础蓄力 → 完美窗口 → 后置蓄力档位）在 **Ability 基类**里（见 docs/abilities.md），本行只填列：ChargeBaseSeconds=0.5、PerfectWindowSeconds=0.2，两个绝对值 PerfectDamage=40 / PerfectSpeed=400 走 Params。★ AnimSpeedScale 是「逻辑帧跟着动画走」那条线：0.2× 让源段的 ATK 帧（0.10s）正好落在基础蓄力完成（0.5s）处；改蓄力时长按同比例改它就仍然对齐。⚠️ 完美时机由**松手**决定（不再是"
Params = [SubResource("p_a1_w1_2_0"), SubResource("p_a1_w1_2_1"), SubResource("p_a1_w1_2_2"), SubResource("p_a1_w1_2_3"), SubResource("p_a1_w1_2_4"), SubResource("p_a1_w1_2_5"), SubResource("p_a1_w1_2_6"), SubResource("p_a1_w1_2_7"), SubResource("p_a1_w1_2_8"), SubResource("p_a1_w1_2_9")]
