[gd_resource type="Resource" script_class="AbilityConfig" format=3 uid="uid://dndijekrbflx8"]

[ext_resource type="Script" uid="uid://c12mw26vliwue" path="res://Scripts/Config/AbilityConfig.cs" id="1_row"]
[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_a1_skill_1_0"]
script = ExtResource("2_param")
Key = "BackwardForce"
Value = 20.0
Note = "旧冲量模式兼容参数；定距模式BackwardDistance>0时不参与水平位移。"

[sub_resource type="Resource" id="p_a1_skill_1_1"]
script = ExtResource("2_param")
Key = "UpwardForce"
Note = "额外抬高的垂直分量（0 = 纯水平后撤；文档没写 → 预设 0）"

[sub_resource type="Resource" id="p_a1_skill_1_2"]
script = ExtResource("2_param")
Key = "InvulnerableFromEvent"
Value = "Dodge"
Note = "★ 文档：帧 Dodge 开无敌"

[sub_resource type="Resource" id="p_a1_skill_1_3"]
script = ExtResource("2_param")
Key = "InvulnerableToEvent"
Value = "Dodger"
Note = "★ 文档：帧 Dodger 关无敌"

[sub_resource type="Resource" id="p_a1_skill_1_4"]
script = ExtResource("2_param")
Key = "InvulnerableSafetySeconds"
Value = 3.0
Note = "超时兜底：Dodger 帧没来也要把无敌关掉（否则玩家会永久无敌）"

[sub_resource type="Resource" id="p_distance"]
script = ExtResource("2_param")
Key = "BackwardDistance"
Value = 12.0
Note = "066覆盖059：在6米基础上再次翻倍为12米。"

[sub_resource type="Resource" id="p_travel"]
script = ExtResource("2_param")
Key = "TravelSeconds"
Value = 0.3
Note = "066：真实Dodge开启后0.3秒完成位移，保留碰撞、重力和原动画无敌开关。"

[resource]
script = ExtResource("1_row")
NodeName = "AbilitySkill1"
ClassHint = "BackdashAbility"
InputAction = "skill_1"
AnimName = "Skill_A1_Backdash"
AnimEvent = "Dodge"
AnimEventEnd = "Dodger"
Cooldown = 10.0
Windup = 0.0
Recover = 0.4
NumericId = 1168
Id = "skl_a1_skill_1"
DisplayName = "后撤"
DescriptionTemplate = "按 Q：在 {TravelSeconds:0.##} 秒内向后移动 {BackwardDistance:0.##} 米（不改变朝向，会被挡住/挤开），帧 Dodge 到 Dodger 期间无敌。CD {Cooldown:0}s。"
Note = "066覆盖059：真实Dodge事件后向后移动12米，水平位移在0.3秒完成。MoveAndSlide保留地形碰撞，重力与外力仍生效；Dodger关闭无敌，等待位移结束再收招，不改源动画。"
Params = [SubResource("p_a1_skill_1_0"), SubResource("p_a1_skill_1_1"), SubResource("p_a1_skill_1_2"), SubResource("p_a1_skill_1_3"), SubResource("p_a1_skill_1_4"), SubResource("p_distance"), SubResource("p_travel")]
