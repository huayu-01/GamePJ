[sub_resource type="Resource" id="p_a1_w1_1_0"]
script = ExtResource("2_param")
Key = "ProjectileScenePath"
Value = "res://Scenes/Combat/EnergyWave.tscn"
Note = "能量波预制体（直线 / 无下坠 / 穿透格挡）"

[sub_resource type="Resource" id="p_a1_w1_1_1"]
script = ExtResource("2_param")
Key = "Speed"
Value = 150.0
Note = "弹速（文档 武技1[波波]：150）"

[sub_resource type="Resource" id="p_a1_w1_1_2"]
script = ExtResource("2_param")
Key = "Damage"
Value = 10.0
Note = "伤害（文档 武技1[波波]：10）"

[sub_resource type="Resource" id="p_a1_w1_1_3"]
script = ExtResource("2_param")
Key = "MaxLifetime"
Value = 1.6
Note = "存活时间（秒）"

[sub_resource type="Resource" id="p_a1_w1_1_4"]
script = ExtResource("2_param")
Key = "Pierce"
Note = "穿透数量（0 = 命中即消失；「穿透」增幅经 StatSheet.PierceAdd 叠加）"

[sub_resource type="Resource" id="p_a1_w1_1_5"]
script = ExtResource("2_param")
Key = "Knockback"
Note = "击退（doc 未写 = 0）"

[sub_resource type="Resource" id="p_a1_w1_1_6"]
script = ExtResource("2_param")
Key = "BypassBlock"
Value = true
Note = "★ 子弹特性：能穿透格挡（无视格挡效果）—— 文档「能量波」条目"

[sub_resource type="Resource" id="p_a1_w1_1_7"]
script = ExtResource("2_param")
Key = "AttackTags"
Value = PackedStringArray("Projectile", "Energy", "Physical")
Note = "攻击标签（供增幅的武器标签匹配）"

[sub_resource type="Resource" id="p_a1_w1_1_8"]
script = ExtResource("2_param")
Key = "MaxAimDistance"
Value = 200.0
Note = "求「准星打到的世界点」时射线的最大长度（无命中时用它定方向）—— 与枪械 PlayerWeaponInput.MaxAimDistance 同一个 200，口径一致"

