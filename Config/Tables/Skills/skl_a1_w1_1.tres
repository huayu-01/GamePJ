Aim = 2
Cooldown = 0.5
Windup = 0.08
Recover = 0.42
Enabled = true
Params = [SubResource("p_a1_w1_1_0"), SubResource("p_a1_w1_1_1"), SubResource("p_a1_w1_1_2"), SubResource("p_a1_w1_1_3"), SubResource("p_a1_w1_1_4"), SubResource("p_a1_w1_1_5"), SubResource("p_a1_w1_1_6"), SubResource("p_a1_w1_1_7")]
Id = "skl_a1_w1_1"
Slot = 0
DisplayName = "波波"
DescriptionTemplate = "朝准星发射一发能量波：伤害 {Damage:0} / 弹速 {Speed:0}。子弹在动画事件帧 ATK 时发射。"
Note = "角色 A 武器 1「能量掌」武技1（文档 CD:0.5 / 伤害 10 / 弹速 150）。★ 子弹特性：直线无下坠 + 穿透格挡（无视格挡效果）。全部数值由本行的 Params 给，代码里没有任何一处写死这几项。"