Windup = 0.15
Recover = 0.5
Enabled = true
ApproachMinRange = 3.5
ApproachMaxRange = 9.0
Params = [SubResource("p_skl_enemy_jumping_leap_0"), SubResource("p_skl_enemy_jumping_leap_1"), SubResource("p_skl_enemy_jumping_leap_2")]
