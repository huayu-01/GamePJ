[ext_resource type="Script" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_skl_enemy_jumping_leap_0"]
script = ExtResource("2_param")
Key = "JumpVelocity"
Value = 9.0
Note = "起跳竖直速度"

[sub_resource type="Resource" id="p_skl_enemy_jumping_leap_1"]
