[gd_resource type="Resource" script_class="AbilityConfig" format=3 uid="uid://c5eadgw5bemvf"]

[ext_resource type="Script" uid="uid://c12mw26vliwue" path="res://Scripts/Config/AbilityConfig.cs" id="1_row"]
[ext_resource type="Texture2D" path="res://Assets/UI/Icons/Skills/ic_skill_bow.svg" id="e_hud_icon"]
[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_a3_w1_1_0"]
script = ExtResource("2_param")
Key = "ProjectileScenePath"
Value = "res://Scenes/Combat/Arrow.tscn"
Note = "箭的预制体"

[sub_resource type="Resource" id="p_a3_w1_1_1"]
script = ExtResource("2_param")
Key = "Damage"
Value = 24.0
Note = "★ 基础伤害（文档：每 0.3s 增加 30% —— 那个 30% 是 ChargeStepScale 列，不是这一列；J10 用户裁定后置蓄力间隔是 0.3s，原文旧填的 0.1 是笔误）"

[sub_resource type="Resource" id="p_a3_w1_1_2"]
script = ExtResource("2_param")
Key = "Speed"
Value = 160.0
Note = "★ 基础弹速（文档为 n）。J10 用户裁定「降低整体弹速」→ 220 改成 160（预设值，等用户确认）：原 220 的箭一物理帧飞 3.67m，太快时近距离两只怪容易只结算最近那只"

[sub_resource type="Resource" id="p_a3_w1_1_3"]
script = ExtResource("2_param")
Key = "SpeedPerChargeStep"
Value = 20.0
Note = "★ 文档原话：每 0.3s 增加 30% 的伤害**和 30 射速** —— 射速这一项写的是**绝对值**，所以走这一列（伤害那 30% 走 ChargeStepScale=1.3 的加算）。J10 用户裁定「降低整体弹速」→ 30 改成 20（预设值，等用户确认）：满档（3 个后置档）弹速 = 160 + 20×3 = 220（改前 220 + 30×5 = 370）"

[sub_resource type="Resource" id="p_a3_w1_1_4"]
script = ExtResource("2_param")
Key = "MaxLifetime"
Value = 3.0
Note = "存活时间（秒）"

[sub_resource type="Resource" id="p_a3_w1_1_5"]
script = ExtResource("2_param")
Key = "Count"
Value = 1.0
Note = "★ 一次一发（文档：射出一发弓箭）"

[sub_resource type="Resource" id="p_a3_w1_1_6"]
script = ExtResource("2_param")
Key = "Knockback"
Value = 2.0
Note = "击退（文档为 n → 预设 2）"

[sub_resource type="Resource" id="p_a3_w1_1_7"]
script = ExtResource("2_param")
Key = "GravityScale"
Note = "弓的箭**不下坠**（文档只给短弩的子弹写了「飞行一段距离后会下坠」）"

[sub_resource type="Resource" id="p_a3_w1_1_8"]
script = ExtResource("2_param")
Key = "HomingStatusId"
Value = "Mark"
Note = "★ 文档（刹那之眼）：你射出的箭会追踪被打上「标记」的最近目标 —— 追踪是**箭自己的子弹特性**，所以填在武器 3 的两个武技行上；没有标记时这一项完全不影响弹道"

[sub_resource type="Resource" id="p_a3_w1_1_9"]
script = ExtResource("2_param")
Key = "HomingTurnRateDegrees"
Value = 360.0
Note = "追踪转向速度（度/秒；预设 360）"

[sub_resource type="Resource" id="p_a3_w1_1_10"]
script = ExtResource("2_param")
Key = "HomingRange"
Note = "追踪搜索半径（0 = 不限）"

[sub_resource type="Resource" id="p_a3_w1_1_11"]
script = ExtResource("2_param")
Key = "MaxAimDistance"
Value = 200.0
Note = "求「准星打到的世界点」时射线的最大长度（与枪械/能量掌同一个 200）"

[sub_resource type="Resource" id="p_a3_w1_1_12"]
script = ExtResource("2_param")
Key = "AttackTags"
Value = PackedStringArray("Projectile", "Arrow", "Physical")
Note = "攻击标签（供增幅的武器标签匹配）"

[sub_resource type="Resource" id="p_a3_w1_1_13"]
script = ExtResource("2_param")
Key = "CritChance"
Value = 0.05
Note = "暴击率基准（角色基础 5%）"

[sub_resource type="Resource" id="p_a3_w1_1_14"]
script = ExtResource("2_param")
Key = "SweepMaxHits"
Value = 8
Note = "★ J10「快弹不漏怪」：每个物理帧把**本帧线段**（线段长度 = 实际弹速 × 物理帧时长，逐帧重算）上的所有敌对单位都结算掉，一帧最多结算 8 个（真正的命中数另受穿透预算限制）；命中过一次的单位不重复结算，撞到 World 立刻停下。0 = 不启用（= 改动前每帧只结算最近 1 个）。只给弓武技1 配这一列，其余武器逐位不变。"

[resource]
script = ExtResource("1_row")
ActionMovement = 2
HudIcon = ExtResource("e_hud_icon")
HudColor = Color(1, 0.76, 0.4, 1)
HudOrder = 30
NodeName = "AbilityWeapon3Skill1"
ClassHint = "ArrowVolleyAbility"
InputAction = "weapon_skill_1"
HoldToCharge = true
AnimName = "ATK_A3_Draw"
AnimEvent = "ATK"
AnimSpeedScale = 0.7
ChargeReleaseAnimSpeedScale = 2.0
ChargeBaseSeconds = 0.5
ChargeStepSeconds = 0.3
ChargeStepScale = 1.3
ChargeMaxSeconds = 1.4
Aim = 2
Cooldown = 0.3
Windup = 0.5
Recover = 0.15
Id = "skl_a3_w1_1"
DisplayName = "箭在弦上"
DescriptionTemplate = "按住左键：基础蓄力 {ChargeBaseSeconds:0.##}s 后射出，之后每 {ChargeStepSeconds:0.##}s 增加 {ChargeStepScale} 倍伤害与 +{SpeedPerChargeStep:0} 弹速（最多蓄力 {ChargeMaxSeconds:0.##}s）；没蓄满就松手不释放。"
Note = "[新增行·P3] 角色 A 武器 3「弓」武技1（文档 CD:0.3 / 基础蓄力 0.5s / 每 0.3s +30% 伤害与 +30 射速 / 最多蓄力 1.4 秒）。★ 两个维度分开：伤害那 30% 是**倍率**（ChargeStepScale = 1.3，按基类的 ChargePowerScale 逐档**加算**：1 + 0.3×档）；射速那 30 是**绝对值**（SpeedPerChargeStep，本类自己的列）。★ **J10 用户裁定**：后置蓄力间隔 0.3s（旧填 0.1 是笔误）＋「基础蓄力 + 3 个后置档 = 总共 4 个威力档」→ ChargeMaxSeconds 从 1.0 改成 1.4：基础 0.5s（0 档 ×1.0）/ 0.8s（1 档 ×1.3）/ 1.1s（2 档 ×1.6）/ 1.4s（3 档 ×1.9）。原文那句「最多蓄力 1 秒」已按用户裁定改成 1.4 秒。★ AnimSpeedScale = 0.7 = 源段 ATK 帧（0.35s）÷ 基础蓄力 0.5s。★ 追踪：HomingStatusId = Mark（刹那之眼给目标上的标记），没有标记时弹道不受影响。"
Params = [SubResource("p_a3_w1_1_0"), SubResource("p_a3_w1_1_1"), SubResource("p_a3_w1_1_2"), SubResource("p_a3_w1_1_3"), SubResource("p_a3_w1_1_4"), SubResource("p_a3_w1_1_5"), SubResource("p_a3_w1_1_6"), SubResource("p_a3_w1_1_7"), SubResource("p_a3_w1_1_8"), SubResource("p_a3_w1_1_9"), SubResource("p_a3_w1_1_10"), SubResource("p_a3_w1_1_11"), SubResource("p_a3_w1_1_12"), SubResource("p_a3_w1_1_13"), SubResource("p_a3_w1_1_14")]
