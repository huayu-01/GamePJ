[gd_resource type="Resource" script_class="ChargedAbilityConfig" format=3 uid="uid://c5eadgw5bemvf"]

[ext_resource type="Script" uid="uid://dri773em3nt3t" path="res://Scripts/Config/ChargedAbilityConfig.cs" id="1_row"]
[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_a3_w1_1_0"]
script = ExtResource("2_param")
Key = "ProjectileScenePath"
Value = "res://Scenes/Combat/Arrow.tscn"
Note = "箭的预制体"

[sub_resource type="Resource" id="p_a3_w1_1_1"]
script = ExtResource("2_param")
Key = "Damage"
Value = 32.4
Note = "箭的基础伤害（点）；蓄力档位再乘威力。"

[sub_resource type="Resource" id="p_a3_w1_1_2"]
script = ExtResource("2_param")
Key = "Speed"
Value = 45.0
Note = "箭的基础初速（米/秒）；射程和滞空由初速与重力决定。"

[sub_resource type="Resource" id="p_a3_w1_1_3"]
script = ExtResource("2_param")
Key = "SpeedPerChargeStep"
Value = 6.0
Note = "每个后置档增加6米/秒，普通满蓄63，龙之箭满蓄93；伤害档位不变。"

[sub_resource type="Resource" id="p_a3_w1_1_4"]
script = ExtResource("2_param")
Key = "MaxLifetime"
Value = 24.0
Note = "足够覆盖龙之箭近竖直上射的完整升降；命中地形立即结束。"

[sub_resource type="Resource" id="p_a3_w1_1_5"]
script = ExtResource("2_param")
Key = "Count"
Value = 1.0
Note = "单次射出的箭数（发）。"

[sub_resource type="Resource" id="p_a3_w1_1_6"]
script = ExtResource("2_param")
Key = "Knockback"
Value = 2.0
Note = "箭命中击退（米/秒）。"

[sub_resource type="Resource" id="p_a3_w1_1_7"]
script = ExtResource("2_param")
Key = "GravityScale"
Value = 1.0
Note = "无目标时从出手即受重力；贝塞尔追踪期间由曲线接管三维路径。"

[sub_resource type="Resource" id="p_a3_w1_1_8"]
script = ExtResource("2_param")
Key = "HomingStatusId"
Value = "Mark"
Note = "箭的追踪状态 Id；目标带 Mark 时追踪最近标记目标，无标记不影响弹道。"

[sub_resource type="Resource" id="p_a3_w1_1_9"]
script = ExtResource("2_param")
Key = "HomingTurnRateDegrees"
Value = 360.0
Note = "追踪转向速度（度/秒）；越大转向越快。"

[sub_resource type="Resource" id="p_a3_w1_1_10"]
script = ExtResource("2_param")
Key = "HomingRange"
Value = 45.0
Note = "追踪搜索半径45米，避免远处标记把箭拉向未知区域。"

[sub_resource type="Resource" id="p_a3_w1_1_11"]
script = ExtResource("2_param")
Key = "MaxAimDistance"
Value = 200.0
Note = "求「准星打到的世界点」时射线的最大长度（与枪械/能量掌同一个 200）"

[sub_resource type="Resource" id="p_a3_w1_1_12"]
script = ExtResource("2_param")
Key = "AttackTags"
Value = PackedStringArray("Projectile", "Arrow", "Physical")
Note = "攻击标签（供增幅的武器标签匹配）"

[sub_resource type="Resource" id="p_a3_w1_1_13"]
script = ExtResource("2_param")
Key = "CritChance"
Value = 0.05
Note = "暴击率基准（角色基础 5%）"

[sub_resource type="Resource" id="p_a3_w1_1_14"]
script = ExtResource("2_param")
Key = "SweepMaxHits"
Value = 8
Note = "每物理帧命中预算（次）；0/负数取默认8；预算耗尽下帧续飞，同一身体只结算一次。"

[sub_resource type="Resource" id="p_homing_start"]
script = ExtResource("2_param")
Key = "HomingStartDistance"
Value = 2.5
Note = "离弦后先飞2.5米，之后才开始追踪标记目标。"

[sub_resource type="Resource" id="p_bezier_homing"]
script = ExtResource("2_param")
Key = "BezierHoming"
Value = true
Note = "三次贝塞尔保留出手切线，终点取目标身体中部。"

[resource]
script = ExtResource("1_row")
ChargeReleaseAnimSpeedScale = 2.0
ChargeBaseSeconds = 0.35
AllowEarlyChargeRelease = true
ChargeStepSeconds = 0.3
ChargeStepScale = 1.3
ChargeMaxSeconds = 1.4
NodeName = "AbilityWeapon3Skill1"
ClassHint = "ArrowVolleyAbility"
InputAction = "weapon_skill_1"
ActionMovement = 2
AnimName = "ATK_A3_Draw"
AnimEvent = "ATK"
AnimSpeedScale = 0.7
Aim = 2
Cooldown = 0.3
Windup = 0.5
Recover = 0.15
NumericId = 1174
Id = "skl_a3_w1_1"
DisplayName = "箭在弦上"
DescriptionTemplate = "按住左键：基础蓄力 {ChargeBaseSeconds:0.##}s 后射出，之后每 {ChargeStepSeconds:0.##}s 增加 {ChargeStepScale} 倍伤害与 +{SpeedPerChargeStep:0} 弹速（最多蓄力 {ChargeMaxSeconds:0.##}s）；未完成基础蓄力也可松手，造成基础伤害的 {EarlyReleaseDamageScale:0%}。"
Note = "[新增行·P3] 角色 A 武器 3「弓」武技1（文档 CD:0.3 / 基础蓄力 0.5s / 每 0.3s +30% 伤害与 +30 射速 / 最多蓄力 1.4 秒）。★ 两个维度分开：伤害那 30% 是**倍率**（ChargeStepScale = 1.3，按基类的 ChargePowerScale 逐档**加算**：1 + 0.3×档）；射速那 30 是**绝对值**（SpeedPerChargeStep，本类自己的列）。★ **J10 用户裁定**：后置蓄力间隔 0.3s（旧填 0.1 是笔误）＋「基础蓄力 + 3 个后置档 = 总共 4 个威力档」→ ChargeMaxSeconds 从 1.0 改成 1.4：基础 0.5s（0 档 ×1.0）/ 0.8s（1 档 ×1.3）/ 1.1s（2 档 ×1.6）/ 1.4s（3 档 ×1.9）。原文那句「最多蓄力 1 秒」已按用户裁定改成 1.4 秒。★ AnimSpeedScale = 0.7 = 源段 ATK 帧（0.35s）÷ 基础蓄力 0.5s。★ 追踪：HomingStatusId = Mark（刹那之眼给目标上的标记），没有标记时弹道不受影响。"
Params = [SubResource("p_a3_w1_1_0"), SubResource("p_a3_w1_1_1"), SubResource("p_a3_w1_1_2"), SubResource("p_a3_w1_1_3"), SubResource("p_a3_w1_1_4"), SubResource("p_a3_w1_1_5"), SubResource("p_a3_w1_1_6"), SubResource("p_a3_w1_1_7"), SubResource("p_a3_w1_1_8"), SubResource("p_a3_w1_1_9"), SubResource("p_a3_w1_1_10"), SubResource("p_a3_w1_1_11"), SubResource("p_a3_w1_1_12"), SubResource("p_a3_w1_1_13"), SubResource("p_a3_w1_1_14"), SubResource("p_homing_start"), SubResource("p_bezier_homing")]
