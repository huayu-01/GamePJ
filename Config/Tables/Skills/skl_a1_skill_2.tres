[gd_resource type="Resource" script_class="AbilityConfig" format=3 uid="uid://cukkands5i0ti"]

[ext_resource type="Script" uid="uid://c12mw26vliwue" path="res://Scripts/Config/AbilityConfig.cs" id="1_row"]
[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_a1_skill_2_0"]
script = ExtResource("2_param")
Key = "LeapVelocity"
Value = 16.0
Note = "★ 强力跳跃的起跳速度（m/s）。文档只写「一次强力的跳跃」（n）→ 预设 16（角色表里的普通起跳是 13）"

[sub_resource type="Resource" id="p_a1_skill_2_1"]
script = ExtResource("2_param")
Key = "AllowInAir"
Value = true
Note = "空中也能用（文档没写限制 → 预设允许）"

[sub_resource type="Resource" id="p_a1_skill_2_2"]
script = ExtResource("2_param")
Key = "HoverSeconds"
Value = 3.0
Note = "★ 文档：获得一段时间 {3s} 的滞空"

[sub_resource type="Resource" id="p_a1_skill_2_3"]
script = ExtResource("2_param")
Key = "HoverFallSlowPercent"
Value = 0.9
Note = "★ 文档：滞空时按住跳跃键可大幅减缓 {90}% 下降速度"

[sub_resource type="Resource" id="p_a1_skill_2_4"]
script = ExtResource("2_param")
Key = "RingRadius"
Value = 1.15
Note = "★ 脚底光环半径（文档只说「有按住特效，脚底出现一个光环」，尺寸为 n → 预设 1.15m）"

[sub_resource type="Resource" id="p_a1_skill_2_5"]
script = ExtResource("2_param")
Key = "RingThickness"
Value = 0.07
Note = "光环粗细（预设 0.07m）"

[sub_resource type="Resource" id="p_a1_skill_2_6"]
script = ExtResource("2_param")
Key = "RingHeight"
Value = 0.12
Note = "光环离脚底的高度（预设 0.12m）"

[sub_resource type="Resource" id="p_a1_skill_2_7"]
script = ExtResource("2_param")
Key = "RingColor"
Value = Color(0.45, 0.85, 1, 0.9)
Note = "光环颜色（自发光；预设淡蓝）"

[sub_resource type="Resource" id="p_a1_skill_2_8"]
script = ExtResource("2_param")
Key = "JumpActionOverride"
Value = "jump"
Note = "跳跃键的动作名（滞空组件读它判「按住跳跃键」）"

[resource]
script = ExtResource("1_row")
NodeName = "AbilitySkill2"
ClassHint = "LeapAbility"
InputAction = "skill_2"
AnimName = "Skill_A1_Leap"
AnimEvent = "Action"
Cooldown = 20.0
Windup = 0.15
Recover = 0.35
Id = "skl_a1_skill_2"
DisplayName = "跃升"
DescriptionTemplate = "按 E：强力跳跃（起跳速度 {LeapVelocity:0.#} m/s）并获得 {HoverSeconds:0.#}s 滞空 —— 空中按住跳跃键下落减缓 {HoverFallSlowPercent:0.##}×100%（脚底出现光环），还有跳跃次数时会先执行跳跃。CD {Cooldown:0}s。"
Note = "[新增行·P3] 角色 A 技能2「跃升」（文档 CD:20 / 强力跳跃 / 3s 滞空 / 按住跳跃减缓 90% / 有按住特效脚底光环 / 帧 Action 释放效果）。★ 效果挂在动画事件帧 Action 上（用户裁定：效果随动画帧走）。★ 滞空是一个**独立常驻组件** AirHoverController（玩家场景里的 AirHover 节点）：本技能在 Action 帧就收招了，而 3s 滞空必须活在技能之外；组件按表值（HoverSeconds / HoverFallSlowPercent / 光环四项）工作。★ Ring* 四项与 LeapVelocity 是文档为 n 的预设值。"
Params = [SubResource("p_a1_skill_2_0"), SubResource("p_a1_skill_2_1"), SubResource("p_a1_skill_2_2"), SubResource("p_a1_skill_2_3"), SubResource("p_a1_skill_2_4"), SubResource("p_a1_skill_2_5"), SubResource("p_a1_skill_2_6"), SubResource("p_a1_skill_2_7"), SubResource("p_a1_skill_2_8")]
