[gd_resource type="Resource" script_class="AbilityConfig" format=3]

[ext_resource type="Script" path="res://Scripts/Config/AbilityConfig.cs" id="1_row"]
[ext_resource type="Script" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_a3_w1_2_0"]
script = ExtResource("2_param")
Key = "ZoomFov"
Value = 32.0
Note = "★ 放大视角：放大后的视野角（度；越小越放大）。文档只写「放大视角」（n）→ 预设 32"

[sub_resource type="Resource" id="p_a3_w1_2_1"]
script = ExtResource("2_param")
Key = "ZoomSharpness"
Value = 8.0
Note = "视角放大/还原的平滑速度（1/秒；预设 8）"

[sub_resource type="Resource" id="p_a3_w1_2_2"]
script = ExtResource("2_param")
Key = "MarkStatusId"
Value = "Mark"
Note = "★ 「标记」状态的行 Id（效果表 eff_mark）：可叠加、不限单个目标"

[sub_resource type="Resource" id="p_a3_w1_2_3"]
script = ExtResource("2_param")
Key = "MarkDuration"
Value = 6.0
Note = "★ 文档没写标记持续多久（n）→ 预设 6s"

[sub_resource type="Resource" id="p_a3_w1_2_4"]
script = ExtResource("2_param")
Key = "MarkIntervalSeconds"
Value = 0.5
Note = "★ 文档：每 0.5 秒对准星附近某个目标施加标记"

[sub_resource type="Resource" id="p_a3_w1_2_5"]
script = ExtResource("2_param")
Key = "MarkRadius"
Value = 3.0
Note = "★ 「准星附近」的半径（文档为 n → 预设 3m）：在这个半径内挑离准星点最近的那个目标"

[sub_resource type="Resource" id="p_a3_w1_2_6"]
script = ExtResource("2_param")
Key = "MaxAimDistance"
Value = 200.0
Note = "求「准星打到的世界点」时射线的最大长度（与枪械/能量掌同一个 200）"

[sub_resource type="Resource" id="p_a3_w1_2_7"]
script = ExtResource("2_param")
Key = "DodgeAbilityId"
Value = "skl_a1_skill_1"
Note = "★ 「后撤」技能的**行 Id**：基础蓄力期间被击中时强制触发一次（不消耗层数）。按行 Id 找，不认节点名/类名"

[resource]
script = ExtResource("1_row")
NodeName = "AbilityWeapon3Skill2"
ClassHint = "HawkEyeAbility"
InputAction = "weapon_skill_2"
HoldToCharge = true
AnimName = "ATK_A3_HawkEye"
AnimEvent = "AimOn"
AnimSpeedScale = 1.0
ChargeBaseSeconds = 0.3
Aim = 0
Cooldown = 2.0
Windup = 0.3
Recover = 0.2
Enabled = true
Params = [SubResource("p_a3_w1_2_0"), SubResource("p_a3_w1_2_1"), SubResource("p_a3_w1_2_2"), SubResource("p_a3_w1_2_3"), SubResource("p_a3_w1_2_4"), SubResource("p_a3_w1_2_5"), SubResource("p_a3_w1_2_6"), SubResource("p_a3_w1_2_7")]
Id = "skl_a3_w1_2"
Slot = 0
DisplayName = "刹那之眼"
DescriptionTemplate = "按住右键：基础蓄力 {ChargeBaseSeconds:0.##}s 后放大视角（FOV {ZoomFov:0.#}），之后每 {MarkIntervalSeconds:0.##}s 给准星 {MarkRadius:0.#}m 内最近的目标施加一层「标记」，持续 {MarkDuration:0.##}s；你射出的箭会追踪被打标记的最近目标。基础蓄力期间被击中会无效化这次伤害并强制触发一次不消耗层数的「后撤」。"
Note = "[新增行·P3] 角色 A 武器 3「弓」武技2（文档 CD:2 / 基础蓄力 0.3s / 每 0.5s 标记 / 箭追踪标记目标 / 基础蓄力被击中则无效化 + 强制免费后撤）。★ 四件事的落点：① 基础蓄力走 Ability 基类；② 放大视角 = 改 Camera3D.Fov（ZoomFov）；③ 标记 = 效果表的 eff_mark（**可叠加、不限单目标**：Unit.ApplyStatus 的 MaxStacks 路径）；④ 无效化 = 订阅 Unit.HitReceived（它在 ReceiveHit 里先于无敌判定触发）把 IsInvulnerable 置位，然后按 DodgeAbilityId 找「后撤」强制触发（RefreshCooldown→TryActivate→RefreshCooldown = 不消耗层数）。★ 文档为 n 的（FOV / 标记时长 / 准星半径）都填了最小预设值。★ 本技能**不发射箭**（文档没让它发），追踪在弓的两个武技行上（HomingStatusId = Mark）。"
