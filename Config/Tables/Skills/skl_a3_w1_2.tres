[gd_resource type="Resource" script_class="AbilityConfig" format=3 uid="uid://b0bh8c674p7ia"]

[ext_resource type="Script" uid="uid://c12mw26vliwue" path="res://Scripts/Config/AbilityConfig.cs" id="1_row"]
[ext_resource type="Texture2D" path="res://Assets/UI/Icons/Skills/ic_skill_eye.svg" id="e_hud_icon"]
[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_a3_w1_2_0"]
script = ExtResource("2_param")
Key = "ZoomFov"
Value = 32.0
Note = "★ 放大视角：放大后的视野角（度；越小越放大）。文档只写「放大视角」（n）→ 预设 32"

[sub_resource type="Resource" id="p_a3_w1_2_1"]
script = ExtResource("2_param")
Key = "ZoomSharpness"
Value = 8.0
Note = "视角放大/还原的平滑速度（1/秒；预设 8）"

[sub_resource type="Resource" id="p_a3_w1_2_2"]
script = ExtResource("2_param")
Key = "MarkStatusId"
Value = "Mark"
Note = "★ 「标记」状态的行 Id（效果表 eff_mark）：可叠加、不限单个目标"

[sub_resource type="Resource" id="p_a3_w1_2_3"]
script = ExtResource("2_param")
Key = "MarkDuration"
Value = 6.0
Note = "★ 文档没写标记持续多久（n）→ 预设 6s"

[sub_resource type="Resource" id="p_a3_w1_2_4"]
script = ExtResource("2_param")
Key = "MarkIntervalSeconds"
Value = 0.5
Note = "★ 文档：每 0.5 秒对准星附近某个目标施加标记"

[sub_resource type="Resource" id="p_a3_w1_2_5"]
script = ExtResource("2_param")
Key = "MarkRadius"
Value = 3.0
Note = "★ 「准星附近」的半径（文档为 n → 预设 3m）：在这个半径内挑离准星点最近的那个目标"

[sub_resource type="Resource" id="p_a3_w1_2_6"]
script = ExtResource("2_param")
Key = "MaxAimDistance"
Value = 200.0
Note = "求「准星打到的世界点」时射线的最大长度（与枪械/能量掌同一个 200）"

[sub_resource type="Resource" id="p_a3_w1_2_7"]
script = ExtResource("2_param")
Key = "DodgeAbilityId"
Value = "skl_a1_skill_1"
Note = "★ 「后撤」技能的行 Id：无动画软启动期间被击中时强制触发一次（不消耗层数）。按行 Id 找，不认节点名/类名"

[resource]
script = ExtResource("1_row")
ActionMovement = 2
HudIcon = ExtResource("e_hud_icon")
HudColor = Color(1, 0.76, 0.4, 1)
HudOrder = 40
NodeName = "AbilityWeapon3Skill2"
ClassHint = "HawkEyeAbility"
InputAction = "weapon_skill_2"
IsBackground = true
HoldToMaintain = true
MaintainStartupSeconds = 0.3
Cooldown = 2.0
Recover = 0.2
Id = "skl_a3_w1_2"
DisplayName = "刹那之眼"
DescriptionTemplate = "按住右键维持纯效果：无动画软启动 {MaintainStartupSeconds:0.##}s 后放大视角（FOV {ZoomFov:0.#}），每 {MarkIntervalSeconds:0.##}s 为准星 {MarkRadius:0.#}m 内最近的目标叠加「标记」，持续 {MarkDuration:0.##}s；可同时使用其他技能，松手停止。启动期间受击仍免伤并强制触发免费后撤。箭会追踪最近的标记目标。"
Note = "[E-1 机制换代] 纯效果按住维持：IsBackground + HoldToMaintain，不播放或停止技能动画，不进入蓄力状态，可以并用其他技能。用户确认保留 0.3s 无动画软启动与其间免伤、免费后撤；启动后按 ZoomFov 放大、每 MarkIntervalSeconds 给准星 MarkRadius 内最近敌人叠加 Mark，松手停止并平滑还原视角。Mark 可叠加、不限单目标；箭的追踪仍由投射物 HomingStatusId=Mark 负责。本技能本身不发射箭，CD 仍为 2s。"
Params = [SubResource("p_a3_w1_2_0"), SubResource("p_a3_w1_2_1"), SubResource("p_a3_w1_2_2"), SubResource("p_a3_w1_2_3"), SubResource("p_a3_w1_2_4"), SubResource("p_a3_w1_2_5"), SubResource("p_a3_w1_2_6"), SubResource("p_a3_w1_2_7")]
