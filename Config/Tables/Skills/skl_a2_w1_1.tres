[gd_resource type="Resource" script_class="AbilityConfig" format=3 uid="uid://d38bwvoaamqkn"]

[ext_resource type="Script" uid="uid://c12mw26vliwue" path="res://Scripts/Config/AbilityConfig.cs" id="1_row"]
[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_a2_w1_1_0"]
script = ExtResource("2_param")
Key = "ProjectileScenePath"
Value = "res://Scenes/Combat/ThrowingKnife.tscn"
Note = "独立飞刀外观；斩弹规则仍属于旧Arrow分类。"

[sub_resource type="Resource" id="p_a2_w1_1_1"]
script = ExtResource("2_param")
Key = "Damage"
Value = 16.2
Note = "第三轮：猎手全武器基础伤害 +35%（12→16.2）。"

[sub_resource type="Resource" id="p_a2_w1_1_2"]
script = ExtResource("2_param")
Key = "Speed"
Value = 36.0
Note = "飞刀散掷初速预设36米/秒。"

[sub_resource type="Resource" id="p_a2_w1_1_3"]
script = ExtResource("2_param")
Key = "MaxLifetime"
Value = 12.0
Note = "允许近竖直上掷自然升降；接触地形仍立即结束。"

[sub_resource type="Resource" id="p_a2_w1_1_4"]
script = ExtResource("2_param")
Key = "Count"
Value = 3.0
Note = "★ 散射发数（文档：散射三发）"

[sub_resource type="Resource" id="p_a2_w1_1_5"]
script = ExtResource("2_param")
Key = "SpreadStepDegrees"
Value = 20.0
Note = "★ 相邻两发的夹角（文档：角度 20）"

[sub_resource type="Resource" id="p_a2_w1_1_6"]
script = ExtResource("2_param")
Key = "GravityStartDistance"
Note = "从出手即受重力，连续抛物线；初始速度使近距离下坠较小。"

[sub_resource type="Resource" id="p_a2_w1_1_7"]
script = ExtResource("2_param")
Key = "GravityScale"
Value = 1.0
Note = "使用引擎重力的真实加速度。"

[sub_resource type="Resource" id="p_a2_w1_1_8"]
script = ExtResource("2_param")
Key = "Knockback"
Value = 6.0
Note = "★ 子弹特性：射速较高时造成击退（文档为 n → 预设 6）"

[sub_resource type="Resource" id="p_a2_w1_1_9"]
script = ExtResource("2_param")
Key = "KnockbackMinSpeed"
Value = 36.0
Note = "★ 弹速门槛：实际弹速 ≥ 它才吃上面的击退（「射速较高的时候才击退」就是这个门槛）"

[sub_resource type="Resource" id="p_a2_w1_1_10"]
script = ExtResource("2_param")
Key = "MaxAimDistance"
Value = 200.0
Note = "求「准星打到的世界点」时射线的最大长度 —— 与枪械/能量掌同一个 200，口径一致"

[sub_resource type="Resource" id="p_a2_w1_1_11"]
script = ExtResource("2_param")
Key = "AttackTags"
Value = PackedStringArray("Projectile", "Arrow", "Physical")
Note = "攻击标签（供增幅的武器标签匹配）"

[sub_resource type="Resource" id="p_a2_w1_1_12"]
script = ExtResource("2_param")
Key = "CritChance"
Value = 0.05
Note = "暴击率基准（角色基础 5%）"

[resource]
script = ExtResource("1_row")
NodeName = "AbilityWeapon2Skill1"
ClassHint = "ArrowVolleyAbility"
InputAction = "weapon_skill_1"
ActionMovement = 2
AnimName = "ATK_A2_Scatter"
AnimEvent = "ATK"
Aim = 2
Cooldown = 1.0
Windup = 0.08
Recover = 0.42
NumericId = 1172
Id = "skl_a2_w1_1"
DisplayName = "飞刀散掷"
DescriptionTemplate = "朝准星方向同时掷出 {Count:0} 把飞刀（相邻夹角 {SpreadStepDegrees:0}°）：每把伤害 {Damage:0} / 飞行速度 {Speed:0}。"
Note = "[新增行·P3] 角色 A 武器 2「飞刀」武技1（文档 CD:1 / 散射三发 / 角度 20 / 伤害 n / 弹速 n）。★ 子弹特性：飞行一段距离后下坠（GravityStartDistance = 10m，射速决定飞完要多久）+ 射速较高时击退（KnockbackMinSpeed 门槛）。★ 文档为 n 的参数（伤害/弹速/下坠距离/重力/击退）都填了**能跑起来的最小预设值**，等实际开发再调。★ 动画走事件帧 ATK（生成表 anim_a2_scatter）。"
Params = [SubResource("p_a2_w1_1_0"), SubResource("p_a2_w1_1_1"), SubResource("p_a2_w1_1_2"), SubResource("p_a2_w1_1_3"), SubResource("p_a2_w1_1_4"), SubResource("p_a2_w1_1_5"), SubResource("p_a2_w1_1_6"), SubResource("p_a2_w1_1_7"), SubResource("p_a2_w1_1_8"), SubResource("p_a2_w1_1_9"), SubResource("p_a2_w1_1_10"), SubResource("p_a2_w1_1_11"), SubResource("p_a2_w1_1_12")]
