[resource]
script = ExtResource("1_row")
HudIcon = ExtResource("icon")
HudColor = Color(0.2, 0.9, 1, 1)
HudOrder = 40
NodeName = "AbilityWeapon4Skill2"
ClassHint = "SpiritSwordsAbility"
InputAction = "weapon_skill_2"
IsBackground = true
Cooldown = 15.0
Id = "skl_b1_w1_2"
DisplayName = "三才灵剑"
DescriptionTemplate = "在头顶召唤3柄灵剑，持续{DurationSeconds:0.##}秒。攻击命中敌人后，灵剑依次高速突刺该目标，随后缓慢归位，完全归位后才能再次追击。冷却{Cooldown:0.##}秒，从召唤时开始。"
Note = "J43按试玩反馈改为命中后定向三连刺，替换J42外圈随挥。固定中→左→右顺序，间隔0.12秒，蓄势0.065秒后以85米/秒突刺；单剑继承本次攻击30%伤害。回位1.1秒、持续10秒、冷却15秒和灵能汲取续时保留。目标死亡／失效收剑，不自动转打旁人；每剑只伤锁定目标一次，归位无伤害。"
Params = [SubResource("Duration"), SubResource("Return"), SubResource("Damage"), SubResource("Reach"), SubResource("Spacing"), SubResource("Windup"), SubResource("FlightTimeout"), SubResource("ChaseDistance")]
