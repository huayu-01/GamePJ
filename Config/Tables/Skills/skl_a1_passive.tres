[gd_resource type="Resource" script_class="AbilityConfig" format=3 uid="uid://crnwfxnlab3ca"]

[ext_resource type="Script" uid="uid://c12mw26vliwue" path="res://Scripts/Config/AbilityConfig.cs" id="1_row"]
[ext_resource type="Texture2D" path="res://Assets/UI/Icons/Skills/ic_skill_feather.svg" id="e_hud_icon"]
[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_a1_passive_0"]
script = ExtResource("2_param")
Key = "Grant"
Value = 1.0
Note = "★ 文档：角色能在空中额外跳跃一次"

[sub_resource type="Resource" id="p_a1_passive_1"]
script = ExtResource("2_param")
Key = "MaxExtraAirJumps"
Value = 3.0
Note = "★ 文档：正常情况下所有角色都只会有 1 次额外的获取方法，**上限最多 3 次**（异化「践踏死亡」也共用这条上限）"

[resource]
script = ExtResource("1_row")
GrantAttackMovement = true
HudIcon = ExtResource("e_hud_icon")
HudColor = Color(0.64, 0.74, 0.88, 1)
HudOrder = 100
NodeName = "AbilityPassive"
ClassHint = "AirJumpPassiveAbility"
Id = "skl_a1_passive"
DisplayName = "灵动"
DescriptionTemplate = "被动：可以边移动边攻击；空中可以额外跳跃 {Grant:0} 次（额外跳跃次数上限 {MaxExtraAirJumps:0} 次）。"
Note = "[新增行·P3] 角色 A 被动「灵动」（文档第 24 行）。★ 没写按键 = 被动（用户裁定：被动可以有 CD，也可以没有按键）→ InputAction 留空，AirJumpPassiveAbility 不靠 TryActivate，而是每帧把「场景基线 + 授予次数」幂等写进 CharacterMovement.SetExtraAirJumps（只有 Enabled=true 时才生效，而 Enabled 由**本行**写进来）。★ 上限 3 是**表里的参数**，不是代码常量（未来异化「践踏死亡」共用它）。★ 被动不需要动画（AnimName 留空 = 这个技能不需要动画），所以不受「没有动画就不执行」那条闸门影响。"
Params = [SubResource("p_a1_passive_0"), SubResource("p_a1_passive_1")]
