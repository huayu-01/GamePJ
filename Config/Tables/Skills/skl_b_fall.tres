[gd_resource type="Resource" script_class="AbilityConfig" format=3 uid="uid://fblwg0hytn5o"]

[ext_resource type="Script" uid="uid://c12mw26vliwue" path="res://Scripts/Config/AbilityConfig.cs" id="1_row"]
[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_DiveSpeed"]
script = ExtResource("2_param")
Key = "DiveSpeed"
Value = 34
Note = "下落速度（m/s）—— 大幅提高下落速度"

[sub_resource type="Resource" id="p_MaxDiveSeconds"]
script = ExtResource("2_param")
Key = "MaxDiveSeconds"
Value = 4
Note = "下落阶段的上限时长（秒）"

[sub_resource type="Resource" id="p_LandRecoverSeconds"]
script = ExtResource("2_param")
Key = "LandRecoverSeconds"
Value = 0.08
Note = "落地后的收招延迟"

[sub_resource type="Resource" id="p_HeightStep"]
script = ExtResource("2_param")
Key = "HeightStep"
Value = 2
Note = "★ 文档写的 n：每多少米加一档（预设 2 米）"

[sub_resource type="Resource" id="p_DamageBonusPerStep"]
script = ExtResource("2_param")
Key = "DamageBonusPerStep"
Value = 0.2
Note = "★ 文档 20%"

[sub_resource type="Resource" id="p_MaxDamageBonus"]
script = ExtResource("2_param")
Key = "MaxDamageBonus"
Value = 1
Note = "★ 文档 最高 100%"

[sub_resource type="Resource" id="p_HomingMode"]
script = ExtResource("2_param")
Key = "HomingMode"
Note = "0 = Straight 直直下落（落日余晖那一行改成 1 = Crosshair）"

[sub_resource type="Resource" id="p_MaxDiveAngleDegrees"]
script = ExtResource("2_param")
Key = "MaxDiveAngleDegrees"
Value = 35
Note = "★ 指向范围（度）：超过就夹到最大范围的同方向上"

[sub_resource type="Resource" id="p_MaxAimDistance"]
script = ExtResource("2_param")
Key = "MaxAimDistance"
Value = 60
Note = "判断准星有没有指向地面的射线长度"

[resource]
script = ExtResource("1_row")
NodeName = "AbilityFallAttack"
ClassHint = "FallAttackAbility"
InputAction = "fall_attack"
AnimName = "Skill_B_Fall"
AnimEvent = "Action"
Cooldown = 1.0
Windup = 0.0
Recover = 0.08
Id = "skl_b_fall"
DisplayName = "落"
DescriptionTemplate = "被动：在空中按下奔跑键或 Ctrl 使用下落攻击；大幅提高下落速度，下落过程中碰到的敌人受伤，高度越高伤害越高（每 {HeightStep:0.##} 米 +20%，最高 +100%）。"
Note = "[P4 新增行] 角色 B 被动「落」（文档 CD:1）。★ 它是**三把武器共用的下落攻击能力**：玩法差异靠行参数（例如落日余晖把 HomingMode 改成 1 + 放宽 MaxDiveAngleDegrees）。★ 高度越高伤害越高：高度取 CharacterMovement.FallHeight（这次离地后**净下落**了多少米，是物理量），每满 HeightStep 米加 DamageBonusPerStep（0.2），封顶 MaxDamageBonus（1.0）。★ 文档里的 n（参数）→ 预设：每 2 米一档。★ 触发键是 project.godot 新增的 fall_attack（Ctrl + 左 Ctrl）。"
Params = [SubResource("p_DiveSpeed"), SubResource("p_MaxDiveSeconds"), SubResource("p_LandRecoverSeconds"), SubResource("p_HeightStep"), SubResource("p_DamageBonusPerStep"), SubResource("p_MaxDamageBonus"), SubResource("p_HomingMode"), SubResource("p_MaxDiveAngleDegrees"), SubResource("p_MaxAimDistance")]
