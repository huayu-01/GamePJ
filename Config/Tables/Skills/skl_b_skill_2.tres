[gd_resource type="Resource" script_class="AbilityConfig" format=3 uid="uid://clwd11ty40q6l"]

[ext_resource type="Script" uid="uid://c12mw26vliwue" path="res://Scripts/Config/AbilityConfig.cs" id="1_row"]
[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_StanceSeconds"]
script = ExtResource("2_param")
Key = "StanceSeconds"
Value = 1.5
Note = "架势/招架持续时间（秒）。"

[sub_resource type="Resource" id="p_GuardOnEvent"]
script = ExtResource("2_param")
Key = "GuardOnEvent"
Value = "GuardOn"
Note = "开架势的动画事件帧名"

[sub_resource type="Resource" id="p_GuardOffEvent"]
script = ExtResource("2_param")
Key = "GuardOffEvent"
Value = "GuardOff"
Note = "收架势的动画事件帧名"

[resource]
script = ExtResource("1_row")
NodeName = "AbilityBSkill2"
ClassHint = "GuardStanceAbility"
InputAction = "skill_2"
AnimName = "Skill_B_Guard"
AnimEvent = "GuardOn"
AnimEventEnd = "GuardOff"
Cooldown = 3.0
Windup = 0.0
Recover = 0.05
NumericId = 1185
Id = "skl_b_skill_2"
DisplayName = "架"
NameKey = "content.skl_b_skill_2.name"
DescriptionTemplate = "进入持续{StanceSeconds:0.##}秒的招架窗口，可连续格挡并反弹敌方远程弹体；格挡者有自身硬直，窗口不因成功格挡提前结束。"
DescriptionKey = "content.skl_b_skill_2.description"
Note = "025/036：真实GuardOn开启，持续时间加倍；每次成功格挡触发各自反馈，反射保留原弹体并切换阵营。"
Params = [SubResource("p_StanceSeconds"), SubResource("p_GuardOnEvent"), SubResource("p_GuardOffEvent")]
