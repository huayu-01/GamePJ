[resource]
script = ExtResource("1_row")
HudIcon = ExtResource("e_hud_icon")
HudColor = Color(0.45, 0.88, 0.8, 1)
HudOrder = 20
NodeName = "AbilityBSkill2"
ClassHint = "GuardStanceAbility"
InputAction = "skill_2"
AnimName = "Skill_B_Guard"
AnimEvent = "GuardOn"
AnimEventEnd = "GuardOff"
Cooldown = 3.0
Windup = 0.0
Recover = 0.05
Id = "skl_b_skill_2"
DisplayName = "架"
DescriptionTemplate = "角色短暂地进入架势 0.75 秒，如果这期间被敌人命中则规避这次攻击并退出架势。"
Note = "J5：仅真实GuardOn开启0.75游戏秒；第一次敌方命中只标记该HitInstance无效并退出。用户确认能规避能量波，普通BlockComponent仍被穿透。同帧第二次命中不共享无敌；收招后派发Parried，刷新不会被覆盖。"
Params = [SubResource("p_StanceSeconds"), SubResource("p_GuardOnEvent"), SubResource("p_GuardOffEvent")]
