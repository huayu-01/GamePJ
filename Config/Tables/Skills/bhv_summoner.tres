[gd_resource type="Resource" script_class="AbilityConfig" load_steps=5 format=3]

[ext_resource type="Script" path="res://Scripts/Config/AbilityConfig.cs" id="1_row"]
[ext_resource type="Script" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_bhv_summoner_0"]
script = ExtResource("2_param")
Key = "AddsPerLevelAdd"
Value = 1
Note = "每次压力升级多召唤几个"

[sub_resource type="Resource" id="p_bhv_summoner_1"]
script = ExtResource("2_param")
Key = "AddSpawnLevelSub"
Value = 1
Note = "提前几级开始召唤"

[resource]
script = ExtResource("1_row")
Id = "bhv_summoner"
DisplayName = "召唤师"
Aim = 0
Windup = 0.3
Recover = 0.3
Enabled = true
Params = [SubResource("p_bhv_summoner_0"), SubResource("p_bhv_summoner_1")]
ApplyHandler = "PressureSummon"
Weight = 1.0
Note = "行为型词条（Boss Build）：改 BossPressure 的召唤节奏。"
