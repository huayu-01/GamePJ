[ext_resource type="Script" uid="uid://5glog82xi77o" path="res://Scripts/Config/ParamEntry.cs" id="2_param"]

[sub_resource type="Resource" id="p_ThrowSpeed"]
script = ExtResource("2_param")
Key = "ThrowSpeed"
Value = 18
Note = "抛出速度（m/s）"

[sub_resource type="Resource" id="p_ReturnSpeed"]
script = ExtResource("2_param")
Key = "ReturnSpeed"
Value = 26
Note = "收回速度（m/s）"

[sub_resource type="Resource" id="p_MaxThrowDistance"]
script = ExtResource("2_param")
Key = "MaxThrowDistance"
Value = 8
Note = "最远抛出距离（米；到点自动收回）"

[sub_resource type="Resource" id="p_RecallOnSecondPress"]
script = ExtResource("2_param")
Key = "RecallOnSecondPress"
Value = true
Note = "★ 再次按键就收回（文档）"

[sub_resource type="Resource" id="p_RecallDistance"]
script = ExtResource("2_param")
Key = "RecallDistance"
Value = 1.8
Note = "★ 靠近武器时收回（文档）"

[sub_resource type="Resource" id="p_SpinDegreesPerSecond"]
script = ExtResource("2_param")
Key = "SpinDegreesPerSecond"
Value = 900
Note = "★ 不断旋转（度/秒）"

[sub_resource type="Resource" id="p_DamageInterval"]
script = ExtResource("2_param")
Key = "DamageInterval"
Value = 0.5
Note = "★ 周期性伤害间隔（文档 0.5s）"

[sub_resource type="Resource" id="p_DamageActiveTime"]
script = ExtResource("2_param")
Key = "DamageActiveTime"
Value = 0.12
Note = "每次判定的持续"

[sub_resource type="Resource" id="p_DamageOnReturn"]
script = ExtResource("2_param")
Key = "DamageOnReturn"
Value = true
Note = "收回途中是否也造成伤害（镰刀文档没写；长枪写了，两把都开）"

[sub_resource type="Resource" id="p_UpwardSpeed"]
script = ExtResource("2_param")
Key = "UpwardSpeed"
Note = "垂直初速（0 = 纯水平，「扔向前方」）"

[sub_resource type="Resource" id="p_ShowPath"]
script = ExtResource("2_param")
Key = "ShowPath"
Value = false
Note = "镰刀不画路径（文档只给长枪写了路径可视化）"

[resource]
script = ExtResource("1_row")
HudIcon = ExtResource("e_hud_icon")
HudColor = Color(1, 0.76, 0.4, 1)
HudOrder = 40
NodeName = "AbilityWeapon5Skill2"
ClassHint = "ScytheThrowAbility"
InputAction = "weapon_skill_2"
Cooldown = 1.0
Windup = 0.0
Recover = 0.05
Id = "skl_b2_w1_2"
DisplayName = "无情"
DescriptionTemplate = "将武器扔向前方，武器会不断旋转并周期性 {DamageInterval:0.##} 秒对武器内的敌人造成伤害；武器飞出去这期间武技1无法使用；再次使用或靠近武器时收回武器。"
Note = "[P4 新增行] 角色 B 武器2 镰刀 武技2（文档 CD:1 / 周期 0.5s）。★ 抛出/收回/旋转/周期伤害全在 WeaponThrowAbility 这一段（与长枪的武技2 共用）。★ 「飞出去这期间武技1无法使用」由场景里的 WeaponGate5 把 InFlight 连到 MeleeComboAbility.ExternallyBlocked。★ n（伤害）= 预设 22。"
Params = [SubResource("p_ThrowSpeed"), SubResource("p_ReturnSpeed"), SubResource("p_MaxThrowDistance"), SubResource("p_RecallOnSecondPress"), SubResource("p_RecallDistance"), SubResource("p_SpinDegreesPerSecond"), SubResource("p_DamageInterval"), SubResource("p_DamageActiveTime"), SubResource("p_DamageOnReturn"), SubResource("p_UpwardSpeed"), SubResource("p_ShowPath")]
