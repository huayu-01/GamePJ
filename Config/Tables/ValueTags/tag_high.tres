[gd_resource type="Resource" script_class="ValueTagConfig" format=3]

[ext_resource type="Script" path="res://Scripts/Config/ValueTagConfig.cs" id="1_row"]

[resource]
script = ExtResource("1_row")
Id = "tag_high"
Slot = 1
DisplayName = "高价值"
WaveCount = 4
AuraColor = Color(1, 0.75, 0.15, 1)
Note = "高价值节点：异化池 / 进化池（Layer = 2）。用户需求「高价值节点会刷 4 波怪」。⚠️ 没有「武器池」这个类型（用户 A3 拍板）：那个叫法指的就是**进化池**（= 武器 / 攻击方式的限定池），按高价值算，所以也挂这个标签。光圈颜色 = **金**（最高价值的通用色，在近白地板与暗天空下都压得住）。"
