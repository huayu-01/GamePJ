[gd_resource type="Resource" script_class="PressureModConfig" load_steps=4 format=3]

[ext_resource type="Script" path="res://Scripts/Config/PressureModConfig.cs" id="1_row"]
[ext_resource type="Script" path="res://Scripts/Config/StatOverride.cs" id="2_stat"]

[sub_resource type="Resource" id="m_pmod_fortress_armor_0"]
script = ExtResource("2_stat")
Stat = "MaxArmorAdd"
Operation = 0
Value = 150.0

[resource]
script = ExtResource("1_row")
Id = "pmod_fortress_armor"
DisplayName = "铁壁·护甲"
DescriptionTemplate = "护甲 +150"
Weight = 2.0
Tags = PackedStringArray("Defense")
StageIds = PackedStringArray("stg_inner", "stg_core")
Modifiers = [SubResource("m_pmod_fortress_armor_0")]
Note = "数值型强化（Boss Pressure 池）：原 pmod_fortress 拆开后的**护甲那一栏**（Add 150，与拆分前逐位一致；叠乘语义 = 同栏抽 2 次 +300）。权重 2 = 继承母行权重（见 pmod_berserk_dmg 的 Note）。⚠ **限定词 StageIds = [stg_inner, stg_core]**：只在第 2、3 关做候选 —— 第 1 关玩家 DPS 最低，Boss 900 血时 +150 甲（= 护甲池 ×1.75）对手感最硬，所以第 1 关抽到它会在 **Boss 出生时重新判定**为不成立、改抽池里另一条（见 docs/config.md 的「限定词与刷新判定」）。"
