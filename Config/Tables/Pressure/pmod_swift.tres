[gd_resource type="Resource" script_class="PressureModConfig" load_steps=4 format=3]

[ext_resource type="Script" path="res://Scripts/Config/PressureModConfig.cs" id="1_row"]
[ext_resource type="Script" path="res://Scripts/Config/StatOverride.cs" id="2_stat"]

[sub_resource type="Resource" id="m_pmod_swift_0"]
script = ExtResource("2_stat")
Stat = "MoveSpeedMultiplier"
Operation = 1
Value = 1.35

[resource]
script = ExtResource("1_row")
Id = "pmod_swift"
DisplayName = "疾行"
DescriptionTemplate = "移速 +35%"
Weight = 2.0
Tags = PackedStringArray("Mobility")
Modifiers = [SubResource("m_pmod_swift_0")]
Note = "数值型强化（Boss Pressure 池）**机动那一栏**（母行 pmod_berserk / pmod_fortress 拆成"一参数一栏"时它本来就是单参数，所以原样保留、文件名不变）。权重 2 = 母行权重（池内合计 15：数值型 12 + 技能型 3），单条 13.3%。效果值 1.35 与拆分前逐位一致。想只让「机动类」进候选，就把抽取点的标签填 Mobility（节点行 BossModifierTags / 关卡行 PressureUpgradeTags）；本行没有限定词（所有关卡都能抽到）。"
