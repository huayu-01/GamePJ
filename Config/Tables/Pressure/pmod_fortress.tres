[gd_resource type="Resource" script_class="PressureModConfig" load_steps=5 format=3]

[ext_resource type="Script" path="res://Scripts/Config/PressureModConfig.cs" id="1_row"]
[ext_resource type="Script" path="res://Scripts/Config/StatOverride.cs" id="2_stat"]

[sub_resource type="Resource" id="m_pmod_fortress_0"]
script = ExtResource("2_stat")
Stat = "MaxHealthMultiplier"
Operation = 1
Value = 1.4

[sub_resource type="Resource" id="m_pmod_fortress_1"]
script = ExtResource("2_stat")
Stat = "MaxArmorAdd"
Operation = 0
Value = 150.0

[resource]
script = ExtResource("1_row")
Id = "pmod_fortress"
DisplayName = "铁壁"
DescriptionTemplate = "最大生命 +40%，护甲 +150"
Weight = 1.0
Modifiers = [SubResource("m_pmod_fortress_0"), SubResource("m_pmod_fortress_1")]
Note = "数值型强化（Boss Pressure 池）：护甲 +150 是 Add，生命 +40% 是 Multiply。"
